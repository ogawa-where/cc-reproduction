 """Rounding and splitting of currency amounts."""
-from decimal import Decimal
+from decimal import ROUND_HALF_UP, Decimal
+
+
+def _reject_float(value: object, name: str) -> None:
+    if isinstance(value, float):
+        raise TypeError(
+            f"{name} must be a Decimal, str or int, not float "
+            "(floats cannot represent cents exactly)"
+        )
 
 
 def round_amount(amount: Decimal | str | int, places: int = 2) -> Decimal:
-    """Return ``amount`` as a Decimal rounded to ``places`` decimal places."""
-    raise NotImplementedError
+    """Return ``amount`` as a Decimal rounded to ``places`` decimal places.
+
+    The result always has exactly ``places`` digits after the decimal point,
+    e.g. ``round_amount("5") == Decimal("5.00")``. Halves round away from
+    zero (``ROUND_HALF_UP``), as is conventional for currency.
+    """
+    _reject_float(amount, "amount")
+    _reject_float(places, "places")
+    exponent = Decimal(1).scaleb(-places)
+    return Decimal(amount).quantize(exponent, rounding=ROUND_HALF_UP)
 
 
 def split_amount(total: Decimal | str | int, parts: int) -> list[Decimal]:
-    """Split ``total`` into ``parts`` amounts that add up to it exactly."""
-    raise NotImplementedError
+    """Split ``total`` into ``parts`` amounts that add up to it exactly.
+
+    The total is first rounded to 2 places with :func:`round_amount`. The
+    parts are as equal as possible; leftover cents go one each to the
+    earliest parts, e.g. ``"10.00"`` in 3 parts is 3.34, 3.33, 3.33.
+    Negative totals are split symmetrically (-3.34, -3.33, -3.33).
+    """
+    _reject_float(total, "total")
+    _reject_float(parts, "parts")
+    if not isinstance(parts, int) or isinstance(parts, bool):
+        raise TypeError("parts must be an int")
+    if parts <= 0:
+        raise ValueError("parts must be a positive integer")
+
+    rounded = round_amount(total, 2)
+    cents = int(rounded.scaleb(2))
+    sign = -1 if cents < 0 else 1
+    base, remainder = divmod(abs(cents), parts)
+
+    cent = Decimal("0.01")
+    return [
+        (Decimal(sign * (base + (1 if i < remainder else 0))) * cent).quantize(cent)
+        for i in range(parts)
+    ]
