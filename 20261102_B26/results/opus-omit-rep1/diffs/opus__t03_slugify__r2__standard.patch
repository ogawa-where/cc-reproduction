 """Turn titles into URL slugs."""
 
 import re
+import unicodedata
 
-# Explicit ASCII ranges: anything else (including non-ASCII letters and digits
-# such as "é" or "²") counts as a separator.
+# Explicit ASCII ranges: anything else counts as a separator.
 _SEPARATORS = re.compile(r"[^A-Za-z0-9]+")
 
+# Latin letters that NFKD does not decompose into ASCII.
+_EXTRA_LATIN = str.maketrans({
+    "ß": "ss", "ẞ": "SS",
+    "Æ": "AE", "æ": "ae",
+    "Œ": "OE", "œ": "oe",
+    "Ø": "O", "ø": "o",
+    "Ł": "L", "ł": "l",
+    "Đ": "D", "đ": "d",
+    "Ð": "D", "ð": "d",
+    "Þ": "TH", "þ": "th",
+    "Ħ": "H", "ħ": "h",
+    "ı": "i",
+})
+
+
+def _to_ascii(text: str) -> str:
+    """Transliterate ``text`` towards ASCII where Unicode allows it.
+
+    NFKD splits accented letters into a base letter plus combining marks
+    ("é" -> "e" + U+0301) and expands compatibility characters ("ﬁ" -> "fi",
+    "²" -> "2"). The combining marks are then dropped, and a few Latin
+    letters without a decomposition ("ß", "Œ", "Ł", ...) are mapped by hand.
+    Characters with no ASCII equivalent (e.g. "日") are kept and later act
+    as separators.
+    """
+    decomposed = unicodedata.normalize("NFKD", text).translate(_EXTRA_LATIN)
+    return "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+
 
