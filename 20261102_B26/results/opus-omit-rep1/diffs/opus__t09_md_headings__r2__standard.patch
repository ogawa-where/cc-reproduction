diff --git a/mdtoc/headings.py b/mdtoc/headings.py
index 6b0680e..2fbac16 100644
--- a/mdtoc/headings.py
+++ b/mdtoc/headings.py
@@ -6,11 +6,38 @@ import re
 # that must be preceded by a space (so "C#" keeps its '#').
 _ATX_HEADING = re.compile(r"^(#{1,6}) +(.*?)(?: +#+)?\s*$")
 
+# A code fence: up to 3 spaces of indentation, then 3+ backticks or tildes,
+# then an optional info string.
+_FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
+
 
 def extract_headings(markdown: str) -> list[tuple[int, str]]:
-    """Return ``(level, text)`` for each ATX heading in ``markdown``."""
+    """Return ``(level, text)`` for each ATX heading in ``markdown``.
+
+    Lines inside fenced code blocks (``` or ~~~) are not headings.
+    """
     headings = []
+    open_fence = None  # the fence string of the code block we're inside
     for line in markdown.splitlines():
+        fence = _FENCE.match(line)
+        if open_fence is None:
+            if fence:
+                marker, info = fence.groups()
+                # A backtick fence's info string may not contain backticks.
+                if not (marker[0] == "`" and "`" in info):
+                    open_fence = marker
+                    continue
+        else:
+            # Closing fence: same character, at least as long, nothing after.
+            if (
+                fence
+                and fence.group(1)[0] == open_fence[0]
+                and len(fence.group(1)) >= len(open_fence)
+                and not fence.group(2).strip()
+            ):
+                open_fence = None
+            continue
+
         match = _ATX_HEADING.match(line)
         if match:
             headings.append((len(match.group(1)), match.group(2).strip()))
diff --git a/tests/test_headings.py b/tests/test_headings.py
index f3cefa8..c83de34 100644
--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -8,3 +8,33 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+def test_closing_hashes_and_non_headings():
+    doc = "## Setup ##\n####### seven\n#hashtag\n# C#\n"
+    assert extract_headings(doc) == [(2, "Setup"), (1, "C#")]
+
+
+def test_skips_fenced_code_blocks():
+    doc = (
+        "# Real\n"
+        "```bash\n"
+        "# a shell comment\n"
+        "```\n"
+        "~~~~\n"
+        "# inside tildes\n"
+        "~~~\n"  # too short to close the ~~~~ fence
+        "# still inside\n"
+        "~~~~\n"
+        "## After\n"
+    )
+    assert extract_headings(doc) == [(1, "Real"), (2, "After")]
+
+
+def test_closing_fence_must_match_character():
+    doc = "```\n~~~\n# inside\n```\n# Out\n"
+    assert extract_headings(doc) == [(1, "Out")]
+
+
+def test_unclosed_fence_runs_to_end():
+    assert extract_headings("# Top\n```\n# never closed\n") == [(1, "Top")]
