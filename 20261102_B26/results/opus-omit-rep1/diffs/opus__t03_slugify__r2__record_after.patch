 """Turn titles into URL slugs."""
 
 import re
+import unicodedata
 
-# Explicit ASCII ranges: anything else (including non-ASCII letters and digits
-# such as "é" or "²") counts as a separator.
+# Explicit ASCII ranges: anything still non-ASCII after normalisation (CJK,
+# emoji, letters like "ß" with no decomposition) counts as a separator.
 _SEPARATORS = re.compile(r"[^A-Za-z0-9]+")
 
 
 def slugify(text: str, max_length: int | None = None) -> str:
     """Return a URL slug for ``text``.
 
-    The slug is lowercase and contains only ASCII letters, digits and single
+    Accented letters are reduced to their ASCII base letter ("Café" ->
+    "cafe"). The slug is lowercase and contains only ASCII letters, digits and single
     hyphens; it never starts or ends with a hyphen. If ``max_length`` is given,
     the slug is cut to at most that many characters and any trailing hyphen is
     removed. If nothing is left, ``"n-a"`` is returned.
     """
-    # Replace separators before lowercasing, so non-ASCII characters that
-    # lowercase to ASCII (e.g. the Kelvin sign "K") are still treated as
-    # separators.
+    # Decompose accented letters ("é" -> "e" + combining accent) and
+    # compatibility characters ("ﬁ" -> "fi", "²" -> "2"), then drop the
+    # combining marks so only the base letters remain.
+    decomposed = unicodedata.normalize("NFKD", text)
+    text = "".join(c for c in decomposed if not unicodedata.combining(c))
     slug = _SEPARATORS.sub("-", text).strip("-").lower()
     if max_length is not None:
         slug = slug[: max(max_length, 0)].rstrip("-")
