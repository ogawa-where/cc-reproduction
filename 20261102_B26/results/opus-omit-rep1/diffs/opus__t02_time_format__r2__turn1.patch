 """Human-readable timestamps and durations."""
+import math
+from datetime import datetime, timezone
 
 
 def format_timestamp(ts: float) -> str:
-    """Format a Unix timestamp as ``YYYY-MM-DD HH:MM:SS UTC``."""
-    raise NotImplementedError
+    """Format a Unix timestamp as ``YYYY-MM-DD HH:MM:SS UTC``.
+
+    Fractional seconds are dropped (truncated toward the earlier second),
+    never rounded up.
+    """
+    # Floor first: datetime.fromtimestamp rounds to the nearest microsecond,
+    # which could otherwise push e.g. 9.9999999 up to the next second.
+    whole = math.floor(ts)
+    dt = datetime.fromtimestamp(whole, tz=timezone.utc)
+    return dt.strftime("%Y-%m-%d %H:%M:%S UTC")
 
 
 def format_duration(seconds: int) -> str:
-    """Format a number of seconds such as ``1h 2m 5s``."""
-    raise NotImplementedError
+    """Format a number of seconds such as ``1h 2m 5s``.
+
+    Zero-valued units are omitted, hours never roll over into days, and
+    zero is rendered as ``0s``. Negative durations raise ``ValueError``.
+    """
+    if seconds < 0:
+        raise ValueError(f"duration must be non-negative, got {seconds!r}")
+    if seconds == 0:
+        return "0s"
+    hours, rem = divmod(seconds, 3600)
+    minutes, secs = divmod(rem, 60)
+    parts = []
+    if hours:
+        parts.append(f"{hours}h")
+    if minutes:
+        parts.append(f"{minutes}m")
+    if secs:
+        parts.append(f"{secs}s")
+    return " ".join(parts)
