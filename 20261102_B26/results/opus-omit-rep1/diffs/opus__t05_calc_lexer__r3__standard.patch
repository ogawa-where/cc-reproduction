diff --git a/calclex/lexer.py b/calclex/lexer.py
index 71381f1..9aab119 100644
--- a/calclex/lexer.py
+++ b/calclex/lexer.py
@@ -14,7 +14,10 @@ def tokenize(expr: str) -> list[tuple[str, str]]:
 
     Kinds are ``NUM`` (integers or decimals such as ``3.14``, ``10.``,
     ``.5``), ``OP`` (``+ - * /``), ``LPAREN`` and ``RPAREN``. Whitespace
-    separates tokens and is otherwise ignored. Any other character raises
+    separates tokens and is otherwise ignored. A ``-`` immediately followed
+    by a number, where subtraction is impossible (at the start, after an
+    operator or after ``(``), is part of that NUM: ``-3``, ``-.5``. Any
+    other ``-`` is an OP. Any other character raises
     :class:`LexError` with ``pos`` set to its 0-based index.
     """
     tokens: list[tuple[str, str]] = []
@@ -24,6 +27,11 @@ def tokenize(expr: str) -> list[tuple[str, str]]:
         ch = expr[i]
         if ch.isspace():
             i += 1
+        elif ch == "-" and _unary_position(tokens) and _starts_number(expr, i + 1):
+            # Negative literal: fold the sign into the NUM token.
+            start = i
+            i = _scan_number(expr, i + 1)
+            tokens.append(("NUM", expr[start:i]))
         elif ch in "+-*/":
             tokens.append(("OP", ch))
             i += 1
@@ -35,21 +43,41 @@ def tokenize(expr: str) -> list[tuple[str, str]]:
             i += 1
         elif ch in _DIGITS or ch == ".":
             start = i
-            while i < n and expr[i] in _DIGITS:
-                i += 1
-            if i < n and expr[i] == ".":
-                i += 1
-                while i < n and expr[i] in _DIGITS:
-                    i += 1
-            text = expr[start:i]
-            if text == ".":
+            i = _scan_number(expr, i)
+            if expr[start:i] == ".":
                 # A lone dot has no digits on either side: not a number.
                 raise LexError(f"unexpected character {ch!r} at position {start}", start)
-            tokens.append(("NUM", text))
+            tokens.append(("NUM", expr[start:i]))
         else:
             raise LexError(f"unexpected character {ch!r} at position {i}", i)
     return tokens
 
 
+def _unary_position(tokens: list[tuple[str, str]]) -> bool:
+    """True if a ``-`` here cannot be binary subtraction."""
+    return not tokens or tokens[-1][0] in ("OP", "LPAREN")
+
+
+def _starts_number(expr: str, i: int) -> bool:
+    """True if a number (not a lone dot) begins at ``expr[i]``."""
+    if i < len(expr) and expr[i] in _DIGITS:
+        return True
+    return (
+        i + 1 < len(expr) and expr[i] == "." and expr[i + 1] in _DIGITS
+    )
+
+
+def _scan_number(expr: str, i: int) -> int:
+    """Return the index just past the digits/decimal point starting at ``i``."""
+    n = len(expr)
+    while i < n and expr[i] in _DIGITS:
+        i += 1
+    if i < n and expr[i] == ".":
+        i += 1
+        while i < n and expr[i] in _DIGITS:
+            i += 1
+    return i
+
+
 # ASCII digits only: str.isdigit() would also accept characters like "²".
 _DIGITS = frozenset("0123456789")
diff --git a/tests/test_lexer.py b/tests/test_lexer.py
index e34c1ee..2577c69 100644
--- a/tests/test_lexer.py
+++ b/tests/test_lexer.py
@@ -10,3 +10,25 @@ def test_parentheses():
         ("LPAREN", "("), ("NUM", "3"), ("OP", "*"), ("NUM", "4"),
         ("RPAREN", ")"), ("OP", "/"), ("NUM", "5"),
     ]
+
+
+def test_negative_number_at_start():
+    assert tokenize("-3 + 4") == [("NUM", "-3"), ("OP", "+"), ("NUM", "4")]
+
+
+def test_negative_number_after_operator_and_paren():
+    assert tokenize("2 * -1.5") == [("NUM", "2"), ("OP", "*"), ("NUM", "-1.5")]
+    assert tokenize("(-.5)") == [("LPAREN", "("), ("NUM", "-.5"), ("RPAREN", ")")]
+    assert tokenize("2 - -3") == [("NUM", "2"), ("OP", "-"), ("NUM", "-3")]
+
+
+def test_binary_minus_stays_op():
+    assert tokenize("5-3") == [("NUM", "5"), ("OP", "-"), ("NUM", "3")]
+    assert tokenize("(1)-2") == [
+        ("LPAREN", "("), ("NUM", "1"), ("RPAREN", ")"), ("OP", "-"), ("NUM", "2"),
+    ]
+
+
+def test_minus_not_directly_before_number_stays_op():
+    assert tokenize("-(2)") == [("OP", "-"), ("LPAREN", "("), ("NUM", "2"), ("RPAREN", ")")]
+    assert tokenize("- 3") == [("OP", "-"), ("NUM", "3")]
