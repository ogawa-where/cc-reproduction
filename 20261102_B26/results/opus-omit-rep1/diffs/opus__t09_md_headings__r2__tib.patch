diff --git a/mdtoc/headings.py b/mdtoc/headings.py
index 6b0680e..65f8ec4 100644
--- a/mdtoc/headings.py
+++ b/mdtoc/headings.py
@@ -6,12 +6,35 @@ import re
 # that must be preceded by a space (so "C#" keeps its '#').
 _ATX_HEADING = re.compile(r"^(#{1,6}) +(.*?)(?: +#+)?\s*$")
 
+# A code fence: up to 3 spaces of indentation, then 3+ backticks or tildes.
+_FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
+
 
 def extract_headings(markdown: str) -> list[tuple[int, str]]:
-    """Return ``(level, text)`` for each ATX heading in ``markdown``."""
+    """Return ``(level, text)`` for each ATX heading in ``markdown``.
+
+    Lines inside fenced code blocks (``` or ~~~) are not headings.
+    """
     headings = []
+    fence = None  # the opening fence run while inside a code block
     for line in markdown.splitlines():
-        match = _ATX_HEADING.match(line)
-        if match:
-            headings.append((len(match.group(1)), match.group(2).strip()))
+        fence_match = _FENCE.match(line)
+        if fence is None:
+            if fence_match:
+                run, info = fence_match.groups()
+                # A backtick fence's info string may not contain backticks.
+                if not (run[0] == "`" and "`" in info):
+                    fence = run
+                    continue
+            match = _ATX_HEADING.match(line)
+            if match:
+                headings.append((len(match.group(1)), match.group(2).strip()))
+        elif (
+            fence_match
+            and fence_match.group(1)[0] == fence[0]
+            and len(fence_match.group(1)) >= len(fence)
+            and not fence_match.group(2).strip()
+        ):
+            # Closing fence: same character, at least as long, nothing after it.
+            fence = None
     return headings
diff --git a/tests/test_headings.py b/tests/test_headings.py
index f3cefa8..0ad264f 100644
--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -8,3 +8,35 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+FENCE = "`" * 3
+
+
+def _doc(*lines):
+    return "\n".join(lines) + "\n"
+
+
+def test_closing_run_and_non_headings():
+    doc = _doc("## Setup ##", "####### seven", "#hashtag", "# C#", "# Title #  ")
+    assert extract_headings(doc) == [(2, "Setup"), (1, "C#"), (1, "Title")]
+
+
+def test_skips_backtick_fenced_code():
+    doc = _doc("# A", FENCE + "bash", "# comment", FENCE, "## B")
+    assert extract_headings(doc) == [(1, "A"), (2, "B")]
+
+
+def test_skips_tilde_fenced_code():
+    doc = _doc("# A", "~~~", "# comment", "~~~", "## B")
+    assert extract_headings(doc) == [(1, "A"), (2, "B")]
+
+
+def test_fence_closes_only_with_same_char_and_length():
+    doc = _doc("~~~~", "# x", "~~~", FENCE, "# still code", "~~~~", "## B")
+    assert extract_headings(doc) == [(2, "B")]
+
+
+def test_unclosed_fence_runs_to_end():
+    doc = _doc("# A", FENCE, "# inside")
+    assert extract_headings(doc) == [(1, "A")]
