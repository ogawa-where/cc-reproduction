 """Parse CSV text into a list of row dicts."""
 
 
+def _split_line(line: str, delimiter: str, line_no: int) -> list[str]:
+    """Split one line into fields, handling double-quoted fields."""
+    fields: list[str] = []
+    i = 0
+    n = len(line)
+    while True:
+        if i < n and line[i] == '"':
+            # Quoted field: read until the closing quote; "" is a literal quote.
+            i += 1
+            chars: list[str] = []
+            while True:
+                if i >= n:
+                    raise ValueError(f"line {line_no}: unterminated quoted field")
+                ch = line[i]
+                if ch == '"':
+                    if i + 1 < n and line[i + 1] == '"':
+                        chars.append('"')
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                chars.append(ch)
+                i += 1
+            fields.append("".join(chars))
+            if i < n and not line.startswith(delimiter, i):
+                raise ValueError(
+                    f"line {line_no}: unexpected character after closing quote"
+                )
+        else:
+            # Unquoted field: everything up to the next delimiter, as written.
+            end = line.find(delimiter, i)
+            if end == -1:
+                end = n
+            fields.append(line[i:end])
+            i = end
+        if i >= n:
+            return fields
+        i += len(delimiter)  # skip the delimiter; a trailing one yields an empty field
+
+
 def parse_csv(text: str, delimiter: str = ",") -> list[dict[str, str]]:
-    """Parse ``text`` and return one dict per data row, keyed by the header names."""
-    raise NotImplementedError
+    """Parse ``text`` and return one dict per data row, keyed by the header names.
+
+    The first line is the header. Fields may be wrapped in double quotes, in
+    which case they may contain the delimiter and ``""`` stands for one literal
+    quote. Blank lines are skipped. Raises ``ValueError`` if a data row's field
+    count differs from the header's, or on malformed quoting.
+    """
+    if not delimiter:
+        raise ValueError("delimiter must be a non-empty string")
+    if '"' in delimiter:
+        raise ValueError("delimiter must not contain a double quote")
+
+    header: list[str] | None = None
+    rows: list[dict[str, str]] = []
+    for line_no, raw in enumerate(text.splitlines(), start=1):
+        if raw == "":
+            continue
+        fields = _split_line(raw, delimiter, line_no)
+        if header is None:
+            header = fields
+            continue
+        if len(fields) != len(header):
+            raise ValueError(
+                f"line {line_no}: expected {len(header)} fields, got {len(fields)}"
+            )
+        rows.append(dict(zip(header, fields)))
+    return rows
