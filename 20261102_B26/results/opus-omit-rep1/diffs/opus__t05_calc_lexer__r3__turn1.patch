diff --git a/calclex/lexer.py b/calclex/lexer.py
index 3497e9b..71381f1 100644
--- a/calclex/lexer.py
+++ b/calclex/lexer.py
@@ -10,5 +10,46 @@ class LexError(ValueError):
 
 
 def tokenize(expr: str) -> list[tuple[str, str]]:
-    """Return the tokens of ``expr`` as ``(kind, text)`` pairs."""
-    raise NotImplementedError
+    """Return the tokens of ``expr`` as ``(kind, text)`` pairs.
+
+    Kinds are ``NUM`` (integers or decimals such as ``3.14``, ``10.``,
+    ``.5``), ``OP`` (``+ - * /``), ``LPAREN`` and ``RPAREN``. Whitespace
+    separates tokens and is otherwise ignored. Any other character raises
+    :class:`LexError` with ``pos`` set to its 0-based index.
+    """
+    tokens: list[tuple[str, str]] = []
+    i = 0
+    n = len(expr)
+    while i < n:
+        ch = expr[i]
+        if ch.isspace():
+            i += 1
+        elif ch in "+-*/":
+            tokens.append(("OP", ch))
+            i += 1
+        elif ch == "(":
+            tokens.append(("LPAREN", ch))
+            i += 1
+        elif ch == ")":
+            tokens.append(("RPAREN", ch))
+            i += 1
+        elif ch in _DIGITS or ch == ".":
+            start = i
+            while i < n and expr[i] in _DIGITS:
+                i += 1
+            if i < n and expr[i] == ".":
+                i += 1
+                while i < n and expr[i] in _DIGITS:
+                    i += 1
+            text = expr[start:i]
+            if text == ".":
+                # A lone dot has no digits on either side: not a number.
+                raise LexError(f"unexpected character {ch!r} at position {start}", start)
+            tokens.append(("NUM", text))
+        else:
+            raise LexError(f"unexpected character {ch!r} at position {i}", i)
+    return tokens
+
+
+# ASCII digits only: str.isdigit() would also accept characters like "²".
+_DIGITS = frozenset("0123456789")
