 """Turn titles into URL slugs."""
 
 import re
+import unicodedata
 
-# Explicit ASCII ranges: anything else (including non-ASCII letters and digits
-# such as "é" or "²") counts as a separator.
+# Explicit ASCII ranges: anything else counts as a separator.
 _SEPARATORS = re.compile(r"[^A-Za-z0-9]+")
 
 
+def _to_ascii(text: str) -> str:
+    """Transliterate ``text`` towards ASCII where Unicode allows it.
+
+    NFKD splits accented letters into a base letter plus combining marks
+    ("é" -> "e" + U+0301) and maps compatibility characters to their plain
+    form ("ﬁ" -> "fi", "²" -> "2"). The combining marks are then dropped.
+    Characters with no ASCII decomposition (e.g. "ß", "中") are left as-is
+    and later treated as separators.
+    """
+    decomposed = unicodedata.normalize("NFKD", text)
+    return "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+
+
 def slugify(text: str, max_length: int | None = None) -> str:
     """Return a URL slug for ``text``.
 
-    The slug is lowercase and contains only ASCII letters, digits and single
