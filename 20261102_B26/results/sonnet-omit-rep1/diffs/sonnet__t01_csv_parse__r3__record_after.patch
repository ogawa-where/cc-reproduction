@@ -26,5 +26,19 @@ def test_mismatch_raises():
             parse_csv(bad)
 
 
+def test_blank_line_is_a_row():
+    import pytest
+
+    with pytest.raises(ValueError):
+        parse_csv("a,b\n1,2\n\n3,4\n")
+    with pytest.raises(ValueError):
+        parse_csv("a,b\n1,2\n\n")
+    assert parse_csv("a\nx\n\ny\n") == [{"a": "x"}, {"a": ""}, {"a": "y"}]
+
+
+def test_empty_input():
+    assert parse_csv("") == []
+
+
 def test_custom_delimiter():
     assert parse_csv("a;b\n1;2", delimiter=";") == [{"a": "1", "b": "2"}]
