diff --git a/lrucache/cache.py b/lrucache/cache.py
index 7031f0e..1b82c89 100644
--- a/lrucache/cache.py
+++ b/lrucache/cache.py
@@ -29,5 +29,7 @@ class LRUCache:
         return len(self._data)
 
     def __contains__(self, key: object) -> bool:
-        # Membership checks do not affect recency.
-        return key in self._data
+        if key in self._data:
+            self._data.move_to_end(key)
+            return True
+        return False
diff --git a/tests/test_cache.py b/tests/test_cache.py
index 68a3a67..8d80e0e 100644
--- a/tests/test_cache.py
+++ b/tests/test_cache.py
@@ -40,3 +40,13 @@ def test_invalid_capacity():
     for bad in (0, -1):
         with pytest.raises(ValueError):
             LRUCache(bad)
+
+
+def test_contains_counts_as_use():
+    cache = LRUCache(2)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    assert "a" in cache
+    cache.put("c", 3)
+    assert "b" not in cache
+    assert "a" in cache
