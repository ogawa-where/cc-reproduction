+def test_quotes():
+    text = 'a,b\n"x,y","he said ""hi"""\n'
+    assert parse_csv(text) == [{"a": "x,y", "b": 'he said "hi"'}]
+
+
+def test_empty_fields_and_spaces():
+    assert parse_csv("a,b,c\n, x ,\n") == [{"a": "", "b": " x ", "c": ""}]
+
+
+def test_mismatch_raises():
+    import pytest
+
+    for bad in ("a,b\n1\n", "a,b\n1,2,3\n"):
+        with pytest.raises(ValueError):
+            parse_csv(bad)
+
+
 def test_custom_delimiter():
     assert parse_csv("a;b\n1;2", delimiter=";") == [{"a": "1", "b": "2"}]
