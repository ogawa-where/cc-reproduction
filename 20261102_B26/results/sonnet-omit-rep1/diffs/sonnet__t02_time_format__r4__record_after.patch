+
+
+def test_negative_durations():
+    from timefmt.formatting import format_duration
+
+    assert format_duration(-61) == "-1m 1s"
+    assert format_duration(-3600) == "-1h"
+    assert format_duration(-5) == "-5s"
+    assert format_duration(0) == "0s"
