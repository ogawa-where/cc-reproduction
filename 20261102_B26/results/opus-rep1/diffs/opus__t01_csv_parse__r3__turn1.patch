 """Parse CSV text into a list of row dicts."""
 
 
+def _split_line(line: str, delimiter: str) -> list[str]:
+    """Split a single line into fields, handling double-quoted fields."""
+    fields: list[str] = []
+    i = 0
+    n = len(line)
+    dlen = len(delimiter)
+    while True:
+        if i < n and line[i] == '"':
+            # Quoted field.
+            i += 1
+            buf: list[str] = []
+            while True:
+                if i >= n:
+                    raise ValueError(f"unterminated quoted field in line: {line!r}")
+                ch = line[i]
+                if ch == '"':
+                    if i + 1 < n and line[i + 1] == '"':
+                        buf.append('"')
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                buf.append(ch)
+                i += 1
+            fields.append("".join(buf))
+            if i == n:
+                return fields
+            if line.startswith(delimiter, i):
+                i += dlen
+                continue
+            raise ValueError(f"unexpected character after closing quote in line: {line!r}")
+        # Unquoted field: runs until the next delimiter or end of line.
+        end = line.find(delimiter, i)
+        if end == -1:
+            fields.append(line[i:])
+            return fields
+        fields.append(line[i:end])
+        i = end + dlen
+
+
 def parse_csv(text: str, delimiter: str = ",") -> list[dict[str, str]]:
     """Parse ``text`` and return one dict per data row, keyed by the header names."""
-    raise NotImplementedError
+    if not delimiter:
+        raise ValueError("delimiter must be a non-empty string")
+    if '"' in delimiter:
+        raise ValueError("delimiter must not contain a double quote")
+
+    header: list[str] | None = None
+    rows: list[dict[str, str]] = []
+    for line in text.split("\n"):
+        if line.endswith("\r"):
+            line = line[:-1]
+        if not line.strip():
+            continue
+        fields = _split_line(line, delimiter)
+        if header is None:
+            header = fields
+            continue
+        if len(fields) != len(header):
+            raise ValueError(
+                f"row has {len(fields)} fields, expected {len(header)}: {line!r}"
+            )
+        rows.append(dict(zip(header, fields)))
+    return rows
