 """Rounding and splitting of currency amounts."""
-from decimal import Decimal
+from decimal import ROUND_HALF_EVEN, Decimal, localcontext
+
+
+def _to_decimal(value: Decimal | str | int, name: str) -> Decimal:
+    if isinstance(value, float):
+        raise TypeError(
+            f"{name} must be Decimal, str or int, not float "
+            "(floats cannot represent cents exactly)"
+        )
+    if not isinstance(value, (Decimal, str, int)):
+        raise TypeError(
+            f"{name} must be Decimal, str or int, not {type(value).__name__}"
+        )
+    result = Decimal(value)
+    if not result.is_finite():
+        raise ValueError(f"{name} must be a finite number, got {value!r}")
+    return result
 
 
 def round_amount(amount: Decimal | str | int, places: int = 2) -> Decimal:
-    """Return ``amount`` as a Decimal rounded to ``places`` decimal places."""
-    raise NotImplementedError
+    """Return ``amount`` as a Decimal rounded to ``places`` decimal places.
+
+    Ties are rounded half to even, and the result always has exactly
+    ``places`` digits after the decimal point.
+    """
+    if isinstance(places, bool) or not isinstance(places, int):
+        raise TypeError("places must be an int")
+    value = _to_decimal(amount, "amount")
+    quantum = Decimal(1).scaleb(-places)
+    # Make sure the context precision is large enough for the result's
+    # coefficient so quantize never fails on large amounts.
+    needed = max(value.adjusted(), 0) + places + 2
+    with localcontext() as ctx:
+        ctx.prec = max(ctx.prec, needed)
+        return value.quantize(quantum, rounding=ROUND_HALF_EVEN)
 
 
 def split_amount(total: Decimal | str | int, parts: int) -> list[Decimal]:
-    """Split ``total`` into ``parts`` amounts that add up to it exactly."""
-    raise NotImplementedError
+    """Split ``total`` into ``parts`` amounts that add up to it exactly.
+
+    The total is first rounded to 2 places with :func:`round_amount`. The
+    parts are as equal as possible; leftover cents go one each to the
+    earliest parts.
+    """
+    if isinstance(parts, bool) or not isinstance(parts, int):
+        raise TypeError("parts must be an int")
+    if parts < 1:
+        raise ValueError("parts must be at least 1")
+    rounded = round_amount(total, 2)
+    # rounded has exponent -2, so its digits are exactly the cent count.
+    sign, digits, _ = rounded.as_tuple()
+    cents = int("".join(map(str, digits)))
+    base, remainder = divmod(cents, parts)
+    return [
+        Decimal((sign, tuple(map(int, str(base + (1 if i < remainder else 0)))), -2))
+        for i in range(parts)
+    ]
