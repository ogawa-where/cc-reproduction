diff --git a/tests/test_headings.py b/tests/test_headings.py
index f3cefa8..3cb153a 100644
--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -8,3 +8,42 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+def test_headings_inside_fence_ignored():
+    doc = "# A\n```\n# not a heading\n```\n## B\n"
+    assert extract_headings(doc) == [(1, "A"), (2, "B")]
+
+
+def test_fence_with_info_string_does_not_close():
+    doc = "```python\n# comment\n```python\n# still code\n```\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_shorter_fence_does_not_close_longer():
+    doc = "````\n```\n# inside\n```\n````\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_tilde_fence():
+    doc = "~~~\n# inside\n```\n# still inside\n~~~\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_indented_fence():
+    doc = "   ```\n# inside\n   ```\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_inline_code_line_is_not_a_fence():
+    doc = "```foo``` is inline\n# Heading\n"
+    assert extract_headings(doc) == [(1, "Heading")]
+
+
+def test_unclosed_fence_runs_to_end():
+    assert extract_headings("# A\n```\n# B\n") == [(1, "A")]
+
+
+def test_heading_forms():
+    doc = "## Setup ##\n####### seven\n#hashtag\n### C# notes\n# Title#\n"
+    assert extract_headings(doc) == [(2, "Setup"), (3, "C# notes"), (1, "Title#")]
