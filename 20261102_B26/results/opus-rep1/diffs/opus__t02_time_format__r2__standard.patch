+import os
+import time
+
+import pytest
+
+
+@pytest.mark.parametrize(
+    "tz", ["UTC", "America/Los_Angeles", "Asia/Kolkata", "Pacific/Chatham", "America/St_Johns"]
+)
+def test_timestamp_ignores_local_time_zone(tz, monkeypatch):
+    monkeypatch.setenv("TZ", tz)
+    time.tzset()
+    try:
+        assert format_timestamp(1709647629.987) == "2024-03-05 14:07:09 UTC"
+        assert format_timestamp(1720000000) == "2024-07-03 09:46:40 UTC"  # DST period
+    finally:
+        monkeypatch.undo()
+        time.tzset()
