 """Find the headings in a Markdown document."""
 
+import re
+
+# 1-6 '#' characters, at least one space, then the rest of the line.
+_HEADING_RE = re.compile(r"^(#{1,6}) +(.*)$")
+# An optional closing run of '#' characters preceded by a space.
+_CLOSING_RE = re.compile(r" +#+$")
+_FENCE = "```"
+
 
 def extract_headings(markdown: str) -> list[tuple[int, str]]:
     """Return ``(level, text)`` for each ATX heading in ``markdown``."""
-    raise NotImplementedError
+    headings: list[tuple[int, str]] = []
+    in_fence = False
+    for line in markdown.splitlines():
+        if line.startswith(_FENCE):
+            in_fence = not in_fence
+            continue
+        if in_fence:
+            continue
+        match = _HEADING_RE.match(line)
+        if match is None:
+            continue
+        text = _CLOSING_RE.sub("", match.group(2).rstrip()).strip()
+        if text:
+            headings.append((len(match.group(1)), text))
+    return headings
