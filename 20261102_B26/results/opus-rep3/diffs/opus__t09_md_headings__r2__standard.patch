diff --git a/tests/test_headings.py b/tests/test_headings.py
index f3cefa8..e2b818c 100644
--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -8,3 +8,33 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+def test_heading_details():
+    doc = "## Setup ##\n####### seven\n#hashtag\n# C# lang\n"
+    assert extract_headings(doc) == [(2, "Setup"), (1, "C# lang")]
+
+
+def test_fenced_block_ignored():
+    doc = "# A\n```\n# not a heading\n```\n# B\n"
+    assert extract_headings(doc) == [(1, "A"), (1, "B")]
+
+
+def test_fence_with_info_string_does_not_close():
+    doc = "```python\n```python\n# hidden\n```\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_longer_fence_needs_longer_close():
+    doc = "````\n```\n# hidden\n```\n# still hidden\n````\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_inline_code_line_is_not_a_fence():
+    doc = "```x``` is inline\n# Visible\n"
+    assert extract_headings(doc) == [(1, "Visible")]
+
+
+def test_unclosed_fence_runs_to_end():
+    doc = "# A\n```\n# hidden\n"
+    assert extract_headings(doc) == [(1, "A")]
