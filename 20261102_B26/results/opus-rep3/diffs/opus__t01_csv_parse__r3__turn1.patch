 """Parse CSV text into a list of row dicts."""
 
 
+def _split_line(line: str, delimiter: str) -> list[str]:
+    """Split a single line into fields, honouring double-quoted fields."""
+    fields: list[str] = []
+    i = 0
+    n = len(line)
+    while True:
+        if i < n and line[i] == '"':
+            # Quoted field: read until the closing quote; "" is a literal quote.
+            i += 1
+            buf: list[str] = []
+            while True:
+                if i >= n:
+                    raise ValueError(f"unterminated quoted field in line: {line!r}")
+                ch = line[i]
+                if ch == '"':
+                    if i + 1 < n and line[i + 1] == '"':
+                        buf.append('"')
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                buf.append(ch)
+                i += 1
+            fields.append("".join(buf))
+            if i == n:
+                return fields
+            if not line.startswith(delimiter, i):
+                raise ValueError(
+                    f"unexpected character after closing quote in line: {line!r}"
+                )
+            i += len(delimiter)
+        else:
+            end = line.find(delimiter, i)
+            if end == -1:
+                fields.append(line[i:])
+                return fields
+            fields.append(line[i:end])
+            i = end + len(delimiter)
+
+
 def parse_csv(text: str, delimiter: str = ",") -> list[dict[str, str]]:
     """Parse ``text`` and return one dict per data row, keyed by the header names."""
-    raise NotImplementedError
+    if not delimiter:
+        raise ValueError("delimiter must be a non-empty string")
+    if '"' in delimiter:
+        raise ValueError("delimiter must not contain a double quote")
+
+    header: list[str] | None = None
+    rows: list[dict[str, str]] = []
+    for lineno, line in enumerate(text.split("\n"), start=1):
+        if line.endswith("\r"):
+            line = line[:-1]
+        if not line.strip():
+            continue
+        fields = _split_line(line, delimiter)
+        if header is None:
+            header = fields
