 """Deep merge of configuration dictionaries."""
 import copy
+from collections.abc import Mapping
+
+
+def _copy(value):
+    """Return an independent copy of ``value``.
+
+    Mappings of any kind (dict, OrderedDict, MappingProxyType, ...) are
+    rebuilt as plain dicts so the result is uniform and never shares a
+    mapping with the inputs; anything else is deep-copied.
+    """
+    if isinstance(value, Mapping):
+        return {k: _copy(v) for k, v in value.items()}
+    return copy.deepcopy(value)
 
 
 def deep_merge(base: dict, override: dict) -> dict:
