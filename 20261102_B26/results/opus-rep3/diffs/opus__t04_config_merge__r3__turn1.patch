--- a/confmerge/merge.py
+++ b/confmerge/merge.py
@@ -1,6 +1,33 @@
 """Deep merge of configuration dictionaries."""
+import copy
 
 
 def deep_merge(base: dict, override: dict) -> dict:
-    """Return ``base`` with ``override`` merged on top of it."""
-    raise NotImplementedError
+    """Return ``base`` with ``override`` merged on top of it.
+
+    - Keys from both dicts appear in the result.
+    - When both values for a key are dicts, they are merged recursively.
+    - Otherwise the override value wins (lists replace, not concatenate).
+    - An override value of ``None`` removes the key, at any nesting level.
+    - Neither input is modified, and the result shares no mutable
+      containers with either input.
+    """
+    result = {}
+    # Iterate base keys first, then new override keys, to keep a stable order.
+    for key in list(base) + [k for k in override if k not in base]:
+        if key not in override:
+            result[key] = copy.deepcopy(base[key])
+            continue
+        value = override[key]
+        if value is None:
+            continue
+        base_value = base.get(key)
+        if isinstance(value, dict):
+            # Recurse even when base has no dict here, so that None markers
+            # nested inside the override are stripped too.
+            result[key] = deep_merge(
+                base_value if isinstance(base_value, dict) else {}, value
+            )
+        else:
+            result[key] = copy.deepcopy(value)
+    return result
