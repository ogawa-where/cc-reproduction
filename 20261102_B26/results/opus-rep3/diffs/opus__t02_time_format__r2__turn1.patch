 """Human-readable timestamps and durations."""
+import math
+from datetime import datetime, timedelta, timezone
+
+_EPOCH = datetime(1970, 1, 1, tzinfo=timezone.utc)
 
 
 def format_timestamp(ts: float) -> str:
-    """Format a Unix timestamp as ``YYYY-MM-DD HH:MM:SS UTC``."""
-    raise NotImplementedError
+    """Format a Unix timestamp as ``YYYY-MM-DD HH:MM:SS UTC``.
+
+    The result is always in UTC, independent of the local time zone.
+    Fractional seconds are dropped (floored, so the displayed second is the
+    one the instant falls within, including for pre-1970 timestamps).
+    """
+    # Floor to whole seconds first: datetime.fromtimestamp rounds to the
+    # nearest microsecond, which could otherwise bump e.g. 59.9999999 up to
+    # the next second. Adding a timedelta to the epoch also avoids platform
+    # limits on negative timestamps.
+    dt = _EPOCH + timedelta(seconds=math.floor(ts))
+    return dt.strftime("%Y-%m-%d %H:%M:%S UTC")
 
 
 def format_duration(seconds: int) -> str:
-    """Format a number of seconds such as ``1h 2m 5s``."""
-    raise NotImplementedError
+    """Format a number of seconds such as ``1h 2m 5s``.
+
+    Zero-valued units are omitted, hours never roll over into days, and a
+    zero duration is rendered as ``0s``. Negative durations raise
+    ``ValueError``.
+    """
+    if seconds < 0:
+        raise ValueError(f"duration must be non-negative, got {seconds!r}")
+    hours, rem = divmod(seconds, 3600)
+    minutes, secs = divmod(rem, 60)
+    parts = [
+        f"{value}{unit}"
+        for value, unit in ((hours, "h"), (minutes, "m"), (secs, "s"))
+        if value
+    ]
+    return " ".join(parts) or "0s"
