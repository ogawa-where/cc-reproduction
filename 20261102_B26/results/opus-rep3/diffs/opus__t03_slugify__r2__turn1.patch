 """Turn titles into URL slugs."""
+import re
+import unicodedata
+
+_NON_ALNUM = re.compile(r"[^a-z0-9]+")
 
 
 def slugify(text: str, max_length: int | None = None) -> str:
-    """Return a URL slug for ``text``."""
-    raise NotImplementedError
+    """Return a URL slug for ``text``.
+
+    The slug is lowercase ASCII letters and digits separated by single
+    hyphens. Accented letters are transliterated via NFKD normalization
+    with combining marks dropped; any other character acts as a separator.
+    If ``max_length`` is given, the slug is cut to at most that many
+    characters and any trailing hyphen is removed. Returns ``"n-a"`` if
+    nothing is left.
+    """
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(c for c in decomposed if not unicodedata.combining(c))
+    slug = _NON_ALNUM.sub("-", stripped.lower()).strip("-")
+    if max_length is not None:
+        slug = slug[:max(max_length, 0)].rstrip("-")
+    return slug or "n-a"
