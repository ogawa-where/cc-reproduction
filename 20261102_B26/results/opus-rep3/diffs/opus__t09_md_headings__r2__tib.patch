diff --git a/tests/test_headings.py b/tests/test_headings.py
index f3cefa8..5768141 100644
--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -8,3 +8,33 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+def test_heading_inside_fence_is_ignored():
+    doc = "# A\n```\n# not a heading\n```\n## B\n"
+    assert extract_headings(doc) == [(1, "A"), (2, "B")]
+
+
+def test_fence_with_info_string_closes_with_bare_fence():
+    doc = "```python\n# comment\n```\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_info_string_line_does_not_close_fence():
+    doc = "```\n```python\n# still code\n```\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_shorter_run_does_not_close_longer_fence():
+    doc = "````\n```\n# still code\n````\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_indented_fence():
+    doc = "  ```\n# code\n  ```\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_inline_backticks_are_not_a_fence():
+    doc = "```not a fence``` text\n# Real\n"
+    assert extract_headings(doc) == [(1, "Real")]
