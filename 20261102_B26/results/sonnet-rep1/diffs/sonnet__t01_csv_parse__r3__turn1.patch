+def test_quotes_and_blank_lines():
+    text = '\na,b\n"x,1","say ""hi"""\n   \n\n"",z\n'
+    assert parse_csv(text) == [
+        {"a": "x,1", "b": 'say "hi"'},
+        {"a": "", "b": "z"},
+    ]
+
+
+def test_field_count_mismatch():
+    import pytest
+
+    with pytest.raises(ValueError):
+        parse_csv("a,b\n1\n")
+    with pytest.raises(ValueError):
+        parse_csv("a,b\n1,2,3\n")
+
+
