diff --git a/tests/test_cache.py b/tests/test_cache.py
index 2f293ef..b2fce0c 100644
--- a/tests/test_cache.py
+++ b/tests/test_cache.py
@@ -11,3 +11,44 @@ def test_missing_key_returns_default():
     cache = LRUCache(2)
     assert cache.get("nope") is None
     assert cache.get("nope", 0) == 0
+
+
+def _full():
+    cache = LRUCache(2)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    return cache
+
+
+def test_evicts_least_recently_used():
+    cache = _full()
+    cache.put("c", 3)
+    assert "a" not in cache and "b" in cache and "c" in cache
+
+
+def test_get_refreshes_recency():
+    cache = _full()
+    cache.get("a")
+    cache.put("c", 3)
+    assert "a" in cache and "b" not in cache
+
+
+def test_put_existing_refreshes_without_evicting():
+    cache = _full()
+    cache.put("a", 9)
+    assert len(cache) == 2 and cache.get("a") == 9
+    cache.put("c", 3)
+    assert "a" in cache and "b" not in cache
+
+
+def test_contains_does_not_refresh():
+    cache = _full()
+    assert "a" in cache
+    cache.put("c", 3)
+    assert "a" not in cache and "b" in cache
+
+
+def test_invalid_capacity():
+    import pytest
+    with pytest.raises(ValueError):
+        LRUCache(0)
