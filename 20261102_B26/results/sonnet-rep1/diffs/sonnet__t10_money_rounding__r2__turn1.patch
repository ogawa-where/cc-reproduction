+
+
+import pytest
+
+
+def test_round_pads_places():
+    assert str(round_amount("5")) == "5.00"
+    assert str(round_amount(5, 3)) == "5.000"
+
+
+def test_round_half_even():
+    assert round_amount("0.125") == Decimal("0.12")
+    assert round_amount("0.135") == Decimal("0.14")
+    assert round_amount("2.5", 0) == Decimal("2")
+
+
+def test_float_rejected():
+    with pytest.raises(TypeError):
+        round_amount(1.5)
+    with pytest.raises(TypeError):
+        split_amount(1.5, 2)
+
+
+def test_split_leftover():
+    assert split_amount("10.00", 3) == [Decimal("3.34"), Decimal("3.33"), Decimal("3.33")]
+    assert split_amount("-10.00", 3) == [Decimal("-3.34"), Decimal("-3.33"), Decimal("-3.33")]
+    assert sum(split_amount("0.05", 7)) == Decimal("0.05")
+    assert split_amount("10.005", 2) == [Decimal("5.00"), Decimal("5.00")]
