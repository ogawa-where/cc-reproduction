diff --git a/calclex/lexer.py b/calclex/lexer.py
index 4a67890..85ce8c3 100644
--- a/calclex/lexer.py
+++ b/calclex/lexer.py
@@ -30,6 +30,8 @@ def tokenize(expr: str) -> list[tuple[str, str]]:
         if m:
             tokens.append(("NUM", expr[i:m.end()]))
             i = m.end()
+        elif unary:
