diff --git a/calclex/lexer.py b/calclex/lexer.py
index 3497e9b..3d0c6b5 100644
--- a/calclex/lexer.py
+++ b/calclex/lexer.py
@@ -1,4 +1,7 @@
 """Split an arithmetic expression into tokens."""
+import re
+
+_NUM = re.compile(r"\d+\.?\d*|\.\d+")
 
 
 class LexError(ValueError):
@@ -11,4 +14,34 @@ class LexError(ValueError):
 
 def tokenize(expr: str) -> list[tuple[str, str]]:
     """Return the tokens of ``expr`` as ``(kind, text)`` pairs."""
-    raise NotImplementedError
+    tokens: list[tuple[str, str]] = []
+    i, n = 0, len(expr)
+    while i < n:
+        ch = expr[i]
+        if ch.isspace():
+            i += 1
+            continue
+        unary = not tokens or tokens[-1][0] == "LPAREN" or tokens[-1][0] == "OP"
+        start = i
+        if ch == "-" and unary:
+            m = _NUM.match(expr, i + 1)
+            if m:
+                tokens.append(("NUM", "-" + m.group()))
+                i = m.end()
+                continue
+        m = _NUM.match(expr, i) if ch in "0123456789." else None
+        if m:
+            tokens.append(("NUM", m.group()))
+            i = m.end()
+        elif ch in "+-*/":
+            tokens.append(("OP", ch))
+            i += 1
+        elif ch == "(":
+            tokens.append(("LPAREN", ch))
+            i += 1
+        elif ch == ")":
+            tokens.append(("RPAREN", ch))
+            i += 1
+        else:
+            raise LexError(f"unexpected character {ch!r} at position {start}", start)
+    return tokens
diff --git a/tests/test_lexer.py b/tests/test_lexer.py
index e34c1ee..467d59a 100644
--- a/tests/test_lexer.py
+++ b/tests/test_lexer.py
@@ -10,3 +10,24 @@ def test_parentheses():
         ("LPAREN", "("), ("NUM", "3"), ("OP", "*"), ("NUM", "4"),
         ("RPAREN", ")"), ("OP", "/"), ("NUM", "5"),
     ]
+
+
+def test_unary_minus():
+    assert tokenize("-3*(-2)") == [
+        ("NUM", "-3"), ("OP", "*"), ("LPAREN", "("), ("NUM", "-2"), ("RPAREN", ")"),
+    ]
+    assert tokenize("5-3") == [("NUM", "5"), ("OP", "-"), ("NUM", "3")]
+    assert tokenize("2*-3") == [("NUM", "2"), ("OP", "*"), ("NUM", "-3")]
+
+
+def test_decimals():
+    assert tokenize("3.14 10. .5") == [("NUM", "3.14"), ("NUM", "10."), ("NUM", ".5")]
+
+
+def test_error_pos():
+    import pytest
+    from calclex import LexError
+    for s, p in [("1 + a", 4), ("$", 0), (".", 0)]:
+        with pytest.raises(LexError) as e:
+            tokenize(s)
+        assert e.value.pos == p
