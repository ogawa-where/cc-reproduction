--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -22,3 +22,26 @@ def test_not_headings():
 def test_fenced_code_ignored():
     doc = "# A\n```python\n# comment\n```\n## B\n"
     assert extract_headings(doc) == [(1, "A"), (2, "B")]
+
+
+def test_longer_fence_needs_longer_close():
+    doc = "````\n```\n# inside\n```\n````\n# out\n"
+    assert extract_headings(doc) == [(1, "out")]
+
+
+def test_tilde_and_indented_fences():
+    doc = "~~~\n# a\n~~~\n   ```\n# b\n   ```\n# c\n"
+    assert extract_headings(doc) == [(1, "c")]
+
+
+def test_closing_fence_with_info_string_does_not_close():
+    doc = "```\n# a\n```python\n# b\n```\n# c\n"
+    assert extract_headings(doc) == [(1, "c")]
+
+
+def test_mismatched_fence_char_does_not_close():
+    assert extract_headings("```\n# a\n~~~\n# b\n```\n# c\n") == [(1, "c")]
+
+
+def test_unclosed_fence_runs_to_end():
+    assert extract_headings("# a\n```\n# b\n## c\n") == [(1, "a")]
