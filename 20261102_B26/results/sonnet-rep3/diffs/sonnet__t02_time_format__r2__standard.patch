diff --git a/tests/test_formatting.py b/tests/test_formatting.py
index cd6aaa0..fc5d146 100644
--- a/tests/test_formatting.py
+++ b/tests/test_formatting.py
@@ -7,3 +7,29 @@ def test_timestamp_epoch():
 
 def test_duration_all_units():
     assert format_duration(3725) == "1h 2m 5s"
+
+
+def test_timestamp_example_and_fraction_dropped():
+    assert format_timestamp(1709647629.9) == "2024-03-05 14:07:09 UTC"
+
+
+def test_timestamp_ignores_local_timezone(monkeypatch):
+    import time
+
+    for tz in ("America/New_York", "Asia/Tokyo", "UTC"):
+        monkeypatch.setenv("TZ", tz)
+        time.tzset()
+        assert format_timestamp(1709647629) == "2024-03-05 14:07:09 UTC"
+    monkeypatch.undo()
+    time.tzset()
+
+
+def test_duration_cases():
+    import pytest
+
+    assert format_duration(0) == "0s"
+    assert format_duration(3600) == "1h"
+    assert format_duration(61) == "1m 1s"
+    assert format_duration(100 * 3600) == "100h"
+    with pytest.raises(ValueError):
+        format_duration(-1)
