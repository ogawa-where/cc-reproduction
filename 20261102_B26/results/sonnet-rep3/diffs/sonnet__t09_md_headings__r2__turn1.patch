diff --git a/mdtoc/headings.py b/mdtoc/headings.py
index 17fa6d6..5bb9c29 100644
--- a/mdtoc/headings.py
+++ b/mdtoc/headings.py
@@ -1,6 +1,24 @@
 """Find the headings in a Markdown document."""
 
+import re
+
+_HEADING = re.compile(r"(#{1,6}) +(.*)")
+_CLOSING = re.compile(r"(?:^|\s+)#+$")
+
 
 def extract_headings(markdown: str) -> list[tuple[int, str]]:
     """Return ``(level, text)`` for each ATX heading in ``markdown``."""
-    raise NotImplementedError
+    headings = []
+    in_fence = False
+    for line in markdown.splitlines():
+        if line.startswith("```"):
+            in_fence = not in_fence
+            continue
+        if in_fence:
+            continue
+        m = _HEADING.fullmatch(line.rstrip())
+        if not m:
+            continue
+        text = _CLOSING.sub("", m.group(2).strip()).strip()
+        headings.append((len(m.group(1)), text))
+    return headings
diff --git a/tests/test_headings.py b/tests/test_headings.py
index f3cefa8..d63b491 100644
--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -8,3 +8,17 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+def test_closing_hashes():
+    assert extract_headings("## Setup ##\n# A#\n### B ###  \n") == [
+        (2, "Setup"), (1, "A#"), (3, "B")]
+
+
+def test_not_headings():
+    assert extract_headings("####### seven\n#hashtag\n#\n") == []
+
+
+def test_fenced_code_ignored():
+    doc = "# A\n```python\n# comment\n```\n## B\n"
+    assert extract_headings(doc) == [(1, "A"), (2, "B")]
