diff --git a/confmerge/merge.py b/confmerge/merge.py
index 6d1c592..051aace 100644
--- a/confmerge/merge.py
+++ b/confmerge/merge.py
@@ -1,6 +1,29 @@
 """Deep merge of configuration dictionaries."""
 
+import copy
+
 
 def deep_merge(base: dict, override: dict) -> dict:
-    """Return ``base`` with ``override`` merged on top of it."""
-    raise NotImplementedError
+    """Return ``base`` with ``override`` merged on top of it.
+
+    - Keys from both dicts appear in the result.
+    - If both values are dicts they are merged recursively; otherwise the
+      override value wins (lists are plain values and are replaced).
+    - An override value of ``None`` removes the key, at any nesting level.
+    - Inputs are never modified and the result shares no mutable state
+      with them.
+    """
+    result = {k: copy.deepcopy(v) for k, v in base.items()}
+    for key, value in override.items():
+        if value is None:
+            result.pop(key, None)
+        elif isinstance(value, dict):
+            existing = result.get(key)
+            # Merge into an empty dict when there is nothing to merge with, so
+            # None markers nested inside new dicts are still dropped.
+            result[key] = deep_merge(
+                existing if isinstance(existing, dict) else {}, value
+            )
+        else:
+            result[key] = copy.deepcopy(value)
+    return result
diff --git a/tests/test_merge.py b/tests/test_merge.py
index 17c6cbc..c6b7c3a 100644
--- a/tests/test_merge.py
+++ b/tests/test_merge.py
@@ -5,6 +5,31 @@ def test_flat_override_wins():
     assert deep_merge({"a": 1, "b": 2}, {"b": 3}) == {"a": 1, "b": 3}
 
 
+def test_none_removes_at_any_level():
+    base = {"a": 1, "n": {"x": 1, "y": 2}}
+    result = deep_merge(base, {"a": None, "n": {"x": None}, "z": None})
+    assert result == {"n": {"y": 2}}
+    assert deep_merge({}, {"n": {"x": None, "y": 1}}) == {"n": {"y": 1}}
+
+
+def test_lists_replace():
+    assert deep_merge({"l": [1, 2]}, {"l": [3]}) == {"l": [3]}
+
+
+def test_inputs_unmodified_and_result_independent():
+    import copy
+
+    base = {"n": {"l": [1]}, "k": {"d": {}}}
+    override = {"o": {"l": [2]}, "n": {"m": 1}}
+    b0, o0 = copy.deepcopy(base), copy.deepcopy(override)
+    r = deep_merge(base, override)
+    assert base == b0 and override == o0
+    r["n"]["l"].append(9)
+    r["k"]["d"]["q"] = 1
+    r["o"]["l"].append(9)
+    assert base == b0 and override == o0
+
+
 def test_nested_merge():
     base = {"db": {"host": "localhost", "port": 5432}}
     override = {"db": {"port": 6543}}
