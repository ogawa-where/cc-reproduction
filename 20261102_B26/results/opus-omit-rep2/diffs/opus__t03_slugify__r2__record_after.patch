@@ -1,6 +1,7 @@
 """Turn titles into URL slugs."""
 
 import re
+import unicodedata
 
 _NON_ALNUM = re.compile(r"[^a-z0-9]+")
 
@@ -14,7 +15,12 @@ def slugify(text: str, max_length: int | None = None) -> str:
     is cut to at most that many characters and any trailing hyphen is removed.
     If nothing is left, ``"n-a"`` is returned.
     """
-    slug = _NON_ALNUM.sub("-", text.lower()).strip("-")
+    # Decompose accented letters (é -> e + combining accent) and drop the
+    # combining marks so the base letter survives. Other non-ASCII characters
+    # (CJK, emoji, ...) are left alone and become separators below.
+    decomposed = unicodedata.normalize("NFKD", text)
+    base = "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+    slug = _NON_ALNUM.sub("-", base.lower()).strip("-")
     if max_length is not None:
         slug = slug[: max(max_length, 0)].rstrip("-")
     return slug or "n-a"
