 """Deep merge of configuration dictionaries."""
 
 import copy
+from collections.abc import Mapping
 
 
 def deep_merge(base: dict, override: dict) -> dict:
@@ -8,22 +9,55 @@ def deep_merge(base: dict, override: dict) -> dict:
 
     Rules:
     - Keys from both dicts appear in the result.
-    - If a key is in both and both values are dicts, they are merged recursively.
-    - Otherwise the override value wins (lists replace, they are not concatenated).
+    - If a key is in both and both values are mappings, they are merged
+      recursively.
+    - Otherwise the override value wins (lists replace, they are not
+      concatenated).
     - An override value of ``None`` removes the key from the result, at any
-      nesting level (including inside dicts that only exist in ``override``).
+      nesting level (including inside mappings that only exist in
+      ``override``).
 
-    Neither input is mutated; the result shares no mutable state with them.
+    Inputs may be any ``Mapping`` (``dict``, ``OrderedDict``,
+    ``MappingProxyType``, ...), and nested mappings are treated the same way.
+    ``None`` in place of either top-level argument counts as an empty config
+    (e.g. what ``yaml.safe_load`` returns for an empty file). Anything else
+    raises ``TypeError``.
+
+    Neither input is mutated. Every mapping in the result is a new plain
+    ``dict``, and the other values are deep copies.
     """
-    result = {key: copy.deepcopy(value) for key, value in base.items()}
+    base = _as_mapping(base, "base")
+    override = _as_mapping(override, "override")
+
+    result = {key: _copy(value) for key, value in base.items()}
     for key, value in override.items():
         if value is None:
             result.pop(key, None)
-        elif isinstance(value, dict):
+        elif isinstance(value, Mapping):
             existing = result.get(key)
             # Merge into an empty dict when there's nothing to merge with, so
             # None-removal markers nested in the override are still applied.
-            result[key] = deep_merge(existing if isinstance(existing, dict) else {}, value)
+            result[key] = deep_merge(
+                existing if isinstance(existing, Mapping) else {}, value
+            )
         else:
-            result[key] = copy.deepcopy(value)
+            result[key] = _copy(value)
     return result
+
+
+def _as_mapping(value, name):
+    if value is None:
+        return {}
+    if not isinstance(value, Mapping):
+        raise TypeError(
+            f"deep_merge() {name} must be a mapping or None, "
+            f"not {type(value).__name__}"
+        )
+    return value
+
+
+def _copy(value):
+    """Copy ``value``, turning every nested mapping into a fresh plain dict."""
+    if isinstance(value, Mapping):
+        return {key: _copy(item) for key, item in value.items()}
+    return copy.deepcopy(value)
diff --git a/tests/test_merge.py b/tests/test_merge.py
index 17c6cbc..96a79e4 100644
--- a/tests/test_merge.py
+++ b/tests/test_merge.py
@@ -1,6 +1,57 @@
+from collections import OrderedDict
+from types import MappingProxyType
+
+import pytest
+
 from confmerge.merge import deep_merge
 
 
+def test_none_removes_key_at_any_level():
+    base = {"a": {"x": 1, "y": 2}, "b": 1}
+    override = {"a": {"x": None}, "b": None, "c": {"k": None, "m": 2}}
+    assert deep_merge(base, override) == {"a": {"y": 2}, "c": {"m": 2}}
+
+
+def test_lists_replace():
+    assert deep_merge({"l": [1, 2]}, {"l": [3]}) == {"l": [3]}
+
+
+def test_inputs_not_mutated_or_aliased():
+    base = {"a": {"l": [1]}}
+    override = {"b": {"l": [2]}}
+    result = deep_merge(base, override)
+    result["a"]["l"].append(9)
+    result["b"]["l"].append(9)
+    assert base == {"a": {"l": [1]}}
+    assert override == {"b": {"l": [2]}}
+
+
+def test_non_dict_mappings_are_merged():
+    base = MappingProxyType({"a": OrderedDict(x=1)})
+    override = {"a": MappingProxyType({"y": 2, "x": None})}
+    result = deep_merge(base, override)
+    assert result == {"a": {"y": 2}}
+    assert type(result) is dict and type(result["a"]) is dict
+
+
+def test_mapping_proxy_in_base_only_is_copied():
+    assert deep_merge({"a": MappingProxyType({"x": 1})}, {}) == {"a": {"x": 1}}
+
+
+def test_none_inputs_are_empty_configs():
+    assert deep_merge(None, {"a": 1, "b": None}) == {"a": 1}
+    assert deep_merge({"a": 1}, None) == {"a": 1}
+    assert deep_merge(None, None) == {}
+
+
+@pytest.mark.parametrize("bad", [[("a", 1)], "a=1", 5])
+def test_non_mapping_inputs_raise_type_error(bad):
+    with pytest.raises(TypeError):
+        deep_merge(bad, {})
+    with pytest.raises(TypeError):
+        deep_merge({}, bad)
+
+
 def test_flat_override_wins():
     assert deep_merge({"a": 1, "b": 2}, {"b": 3}) == {"a": 1, "b": 3}
 
