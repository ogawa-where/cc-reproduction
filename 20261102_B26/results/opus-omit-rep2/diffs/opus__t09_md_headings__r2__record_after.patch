diff --git a/mdtoc/headings.py b/mdtoc/headings.py
index 317826b..23320ae 100644
--- a/mdtoc/headings.py
+++ b/mdtoc/headings.py
@@ -6,12 +6,39 @@ import re
 _HEADING_RE = re.compile(r"^(#{1,6}) +(.*)$")
 # An optional closing run of '#' preceded by a space (or making up the whole text).
 _CLOSING_RE = re.compile(r"(?:^| +)#+$")
+# A code fence: up to 3 spaces of indentation, then 3+ backticks or tildes,
+# then an optional info string.
+_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
 
 
 def extract_headings(markdown: str) -> list[tuple[int, str]]:
-    """Return ``(level, text)`` for each ATX heading in ``markdown``."""
+    """Return ``(level, text)`` for each ATX heading in ``markdown``.
+
+    Lines inside fenced code blocks (``` or ~~~) are never headings. A fence
+    is closed by a line of the same character, at least as long as the
+    opening run, with nothing else after it but whitespace. A fence that is
+    never closed runs to the end of the document.
+    """
     headings = []
+    fence = None  # The opening run of the current code block, if inside one.
     for line in markdown.splitlines():
+        fence_match = _FENCE_RE.match(line)
+        if fence is not None:
+            if (
+                fence_match is not None
+                and fence_match.group(1)[0] == fence[0]
+                and len(fence_match.group(1)) >= len(fence)
+                and not fence_match.group(2).strip()
+            ):
+                fence = None
+            continue
+        if fence_match is not None:
+            run, info = fence_match.groups()
+            # A backtick fence's info string may not contain backticks.
+            if not (run[0] == "`" and "`" in info):
+                fence = run
+                continue
+
         match = _HEADING_RE.match(line)
         if match is None:
             continue
diff --git a/tests/test_headings.py b/tests/test_headings.py
index f3cefa8..0161511 100644
--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -8,3 +8,33 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+def test_heading_inside_backtick_fence_is_ignored():
+    doc = "# Title\n\n```bash\n# install deps\npip install x\n```\n\n## Usage\n"
+    assert extract_headings(doc) == [(1, "Title"), (2, "Usage")]
+
+
+def test_heading_inside_tilde_fence_is_ignored():
+    doc = "~~~\n# not a heading\n~~~\n# Real\n"
+    assert extract_headings(doc) == [(1, "Real")]
+
+
+def test_fence_closes_only_with_same_char_and_enough_length():
+    doc = "````\n```\n# still code\n~~~~\n# still code\n````\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_unclosed_fence_runs_to_end():
+    doc = "# Before\n```\n# code\n## more code\n"
+    assert extract_headings(doc) == [(1, "Before")]
+
+
+def test_closing_fence_with_text_does_not_close():
+    doc = "```\n``` not a close\n# code\n```\n# After\n"
+    assert extract_headings(doc) == [(1, "After")]
+
+
+def test_closing_hashes_and_non_headings():
+    doc = "## Setup ##\n####### no\n#hashtag\n# C#\n"
+    assert extract_headings(doc) == [(2, "Setup"), (1, "C#")]
