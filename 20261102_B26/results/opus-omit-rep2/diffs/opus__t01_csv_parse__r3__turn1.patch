 """Parse CSV text into a list of row dicts."""
 
+_QUOTE = '"'
+
+
+def _split_line(line: str, delimiter: str, lineno: int) -> list[str]:
+    """Split a single CSV line into its fields, handling quoted fields."""
+    fields: list[str] = []
+    i = 0
+    n = len(line)
+    while True:
+        if i < n and line[i] == _QUOTE:
+            # Quoted field: read until a lone closing quote.
+            i += 1
+            buf: list[str] = []
+            while True:
+                if i >= n:
+                    raise ValueError(f"line {lineno}: unterminated quoted field")
+                ch = line[i]
+                if ch == _QUOTE:
+                    if i + 1 < n and line[i + 1] == _QUOTE:
+                        buf.append(_QUOTE)
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                buf.append(ch)
+                i += 1
+            fields.append("".join(buf))
+            if i < n and not line.startswith(delimiter, i):
+                raise ValueError(
+                    f"line {lineno}: unexpected character after closing quote"
+                )
+        else:
+            # Unquoted field: everything up to the next delimiter, verbatim.
+            end = line.find(delimiter, i)
+            if end == -1:
+                end = n
+            fields.append(line[i:end])
+            i = end
+        if i >= n:
+            return fields
+        i += len(delimiter)  # skip delimiter; a trailing one yields an empty field
+
 
 def parse_csv(text: str, delimiter: str = ",") -> list[dict[str, str]]:
     """Parse ``text`` and return one dict per data row, keyed by the header names."""
-    raise NotImplementedError
+    if not delimiter:
+        raise ValueError("delimiter must be a non-empty string")
+    if _QUOTE in delimiter:
+        raise ValueError("delimiter must not contain a double quote")
+
+    header: list[str] | None = None
+    rows: list[dict[str, str]] = []
+    for lineno, line in enumerate(text.split("\n"), start=1):
+        if line.endswith("\r"):
+            line = line[:-1]
+        if line == "":
+            continue  # skip blank lines, including the one after a trailing newline
+        fields = _split_line(line, delimiter, lineno)
+        if header is None:
+            header = fields
+            continue
+        if len(fields) != len(header):
+            raise ValueError(
+                f"line {lineno}: expected {len(header)} fields, got {len(fields)}"
+            )
+        rows.append(dict(zip(header, fields)))
+    return rows
