diff --git a/mdtoc/headings.py b/mdtoc/headings.py
index 317826b..3b6c0e0 100644
--- a/mdtoc/headings.py
+++ b/mdtoc/headings.py
@@ -6,12 +6,37 @@ import re
 _HEADING_RE = re.compile(r"^(#{1,6}) +(.*)$")
 # An optional closing run of '#' preceded by a space (or making up the whole text).
 _CLOSING_RE = re.compile(r"(?:^| +)#+$")
+# Opening code fence: up to 3 spaces of indent, then 3+ backticks or tildes.
+# A backtick fence's info string may not contain backticks.
+_FENCE_OPEN_RE = re.compile(r"^ {0,3}(?:(`{3,})[^`]*|(~{3,}).*)$")
 
 
 def extract_headings(markdown: str) -> list[tuple[int, str]]:
-    """Return ``(level, text)`` for each ATX heading in ``markdown``."""
+    """Return ``(level, text)`` for each ATX heading in ``markdown``.
+
+    Lines inside fenced code blocks (``` or ~~~) are ignored. An unclosed
+    fence runs to the end of the document.
+    """
     headings = []
+    fence = None  # the opening fence string while inside a code block
     for line in markdown.splitlines():
+        if fence is not None:
+            # A closing fence uses the same character, is at least as long
+            # as the opening one, and has nothing but whitespace after it.
+            stripped = line.strip()
+            if (
+                len(line) - len(line.lstrip(" ")) <= 3
+                and len(stripped) >= len(fence)
+                and stripped == fence[0] * len(stripped)
+            ):
+                fence = None
+            continue
+
+        fence_match = _FENCE_OPEN_RE.match(line)
+        if fence_match is not None:
+            fence = fence_match.group(1) or fence_match.group(2)
+            continue
+
         match = _HEADING_RE.match(line)
         if match is None:
             continue
diff --git a/tests/test_headings.py b/tests/test_headings.py
index f3cefa8..699960c 100644
--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -8,3 +8,27 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+def test_ignores_fenced_code_blocks():
+    doc = (
+        "# Install\n\n"
+        "```bash\n# not a heading\npip install mdtoc\n```\n\n"
+        "~~~\n## also not\n~~~\n\n"
+        "## Usage\n"
+    )
+    assert extract_headings(doc) == [(1, "Install"), (2, "Usage")]
+
+
+def test_closing_fence_must_match_opening():
+    doc = "````\n# a\n```\n# b\n~~~~\n# c\n````\n# Done\n"
+    assert extract_headings(doc) == [(1, "Done")]
+
+
+def test_unclosed_fence_runs_to_end():
+    assert extract_headings("# Top\n```\n# hidden\n") == [(1, "Top")]
+
+
+def test_closing_hashes_and_non_headings():
+    doc = "## Setup ##\n####### seven\n#hashtag\n# C#\n"
+    assert extract_headings(doc) == [(2, "Setup"), (1, "C#")]
