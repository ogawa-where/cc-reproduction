--- a/slugkit/slug.py
+++ b/slugkit/slug.py
@@ -1,6 +1,7 @@
 """Turn titles into URL slugs."""
 
 import re
+import unicodedata
 
 _NON_SLUG_RUN = re.compile(r"[^a-z0-9]+")
 
@@ -14,7 +15,12 @@ def slugify(text: str, max_length: int | None = None) -> str:
     is cut to at most that many characters and any trailing hyphen is
     removed. If nothing is left, ``"n-a"`` is returned.
     """
-    slug = _NON_SLUG_RUN.sub("-", text.lower()).strip("-")
+    # Split accented letters into base letter + combining marks (NFKD), then
+    # drop the marks so "Café" -> "Cafe". Characters with no ASCII base
+    # (e.g. "日") are left alone and become separators below.
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+    slug = _NON_SLUG_RUN.sub("-", stripped.lower()).strip("-")
     if max_length is not None:
         slug = slug[:max_length].rstrip("-")
     return slug or "n-a"
