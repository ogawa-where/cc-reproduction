 """Compare and sort dotted version strings."""
 
+import functools
+import re
+
+_NUMBER = re.compile(r"[0-9]+")
+
+
+def _parse(version: str) -> tuple[tuple[int, ...], str | None]:
+    """Split ``version`` into its numeric components and optional pre-release label.
+
+    Raises ``ValueError`` if ``version`` is not a valid version string.
+    """
+    if not isinstance(version, str):
+        raise ValueError(f"version must be a string, got {type(version).__name__}")
+    core, sep, label = version.partition("-")
+    if sep and not label:
+        raise ValueError(f"empty pre-release label in version {version!r}")
+    parts = core.split(".")
+    for part in parts:
+        # fullmatch with an explicit ASCII class rejects "", " 1", "+1", "1_0"
+        # and non-ASCII digits, all of which int() would otherwise accept.
+        if not _NUMBER.fullmatch(part):
+            raise ValueError(f"invalid version {version!r}")
+    return tuple(int(p) for p in parts), (label if sep else None)
+
+
+def _cmp(x, y) -> int:
+    return (x > y) - (x < y)
+
 
 def compare_versions(a: str, b: str) -> int:
     """Return -1 if ``a`` < ``b``, 0 if they are equal, 1 if ``a`` > ``b``."""
-    raise NotImplementedError
+    nums_a, label_a = _parse(a)
+    nums_b, label_b = _parse(b)
+
+    # Missing trailing components count as zero, so "1.0" == "1.0.0".
+    width = max(len(nums_a), len(nums_b))
+    nums_a += (0,) * (width - len(nums_a))
+    nums_b += (0,) * (width - len(nums_b))
+    result = _cmp(nums_a, nums_b)
+    if result:
+        return result
+
+    # A pre-release sorts below the same version without a label.
+    if label_a is None or label_b is None:
+        return _cmp(label_a is None, label_b is None)
+    return _cmp(label_a, label_b)
 
 
 def sort_versions(versions: list[str]) -> list[str]:
     """Return a new list of ``versions`` sorted from lowest to highest."""
-    raise NotImplementedError
+    # Validate up front: sorted() never compares a single-element list.
+    for v in versions:
+        _parse(v)
+    # sorted() is stable, so versions that compare equal keep their order.
+    return sorted(versions, key=functools.cmp_to_key(compare_versions))
