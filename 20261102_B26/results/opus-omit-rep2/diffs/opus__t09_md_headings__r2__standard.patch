@@ -6,12 +6,35 @@ import re
 _HEADING_RE = re.compile(r"^(#{1,6}) +(.*)$")
 # An optional closing run of '#' preceded by a space (or making up the whole text).
 _CLOSING_RE = re.compile(r"(?:^| +)#+$")
+# A code fence: up to 3 spaces of indent, then 3+ backticks or 3+ tildes.
+_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
 
 
 def extract_headings(markdown: str) -> list[tuple[int, str]]:
-    """Return ``(level, text)`` for each ATX heading in ``markdown``."""
+    """Return ``(level, text)`` for each ATX heading in ``markdown``.
+
+    Lines inside fenced code blocks (``` or ~~~) are ignored. A fence that is
+    never closed runs to the end of the document.
+    """
     headings = []
+    open_fence = None  # the fence string that opened the current code block
     for line in markdown.splitlines():
+        fence = _FENCE_RE.match(line)
+        if open_fence is not None:
+            # Close only on the same character, at least as long, nothing after it.
+            if (
+                fence
+                and fence.group(1)[0] == open_fence[0]
+                and len(fence.group(1)) >= len(open_fence)
+                and not fence.group(2).strip()
+            ):
+                open_fence = None
+            continue
+        # A backtick fence's info string may not contain backticks.
+        if fence and not (fence.group(1)[0] == "`" and "`" in fence.group(2)):
+            open_fence = fence.group(1)
+            continue
+
         match = _HEADING_RE.match(line)
         if match is None:
             continue
