diff --git a/mdtoc/headings.py b/mdtoc/headings.py
index b05f3ec..768d827 100644
--- a/mdtoc/headings.py
+++ b/mdtoc/headings.py
@@ -4,12 +4,27 @@ import re
 
 _HEADING = re.compile(r"(#{1,6}) +(.*)")
 _CLOSING = re.compile(r"(?:^|\s+)#+$")
+_FENCE_OPEN = re.compile(r" {0,3}(`{3,}|~{3,})(.*)")
+_FENCE_CLOSE = re.compile(r" {0,3}(`{3,}|~{3,})[ \t]*")
 
 
 def extract_headings(markdown: str) -> list[tuple[int, str]]:
-    """Return ``(level, text)`` for each ATX heading in ``markdown``."""
+    """Return ``(level, text)`` for each ATX heading in ``markdown``.
+
+    Lines inside fenced code blocks (``` or ~~~) are not headings.
+    """
     headings = []
+    fence = None  # the opening fence string while inside a code block
     for line in markdown.splitlines():
+        if fence is not None:
+            close = _FENCE_CLOSE.fullmatch(line)
+            if close and close.group(1)[0] == fence[0] and len(close.group(1)) >= len(fence):
+                fence = None
+            continue
+        opening = _FENCE_OPEN.fullmatch(line)
+        if opening and not (opening.group(1)[0] == "`" and "`" in opening.group(2)):
+            fence = opening.group(1)
+            continue
         match = _HEADING.fullmatch(line)
         if not match:
             continue
diff --git a/tests/test_headings.py b/tests/test_headings.py
index f3cefa8..a87c152 100644
--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -8,3 +8,27 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+def test_headings_in_backtick_fence_ignored():
+    doc = "# A\n```python\n# comment\n## not heading\n```\n## B\n"
+    assert extract_headings(doc) == [(1, "A"), (2, "B")]
+
+
+def test_headings_in_tilde_fence_ignored():
+    assert extract_headings("~~~\n# x\n~~~\n# y\n") == [(1, "y")]
+
+
+def test_fence_needs_matching_close():
+    doc = "````\n# x\n```\n# still code\n````\n# y\n"
+    assert extract_headings(doc) == [(1, "y")]
+    assert extract_headings("~~~\n# x\n```\n# y\n") == []
+
+
+def test_unclosed_fence_runs_to_end():
+    assert extract_headings("# a\n```\n# b\n") == [(1, "a")]
+
+
+def test_closing_fence_has_no_info_string():
+    doc = "```\n```python\n# x\n```\n# y\n"
+    assert extract_headings(doc) == [(1, "y")]
