diff --git a/mdtoc/headings.py b/mdtoc/headings.py
index b05f3ec..8e3c65c 100644
--- a/mdtoc/headings.py
+++ b/mdtoc/headings.py
@@ -4,12 +4,32 @@ import re
 
 _HEADING = re.compile(r"(#{1,6}) +(.*)")
 _CLOSING = re.compile(r"(?:^|\s+)#+$")
+_FENCE = re.compile(r" {0,3}(`{3,}|~{3,})(.*)")
 
 
 def extract_headings(markdown: str) -> list[tuple[int, str]]:
-    """Return ``(level, text)`` for each ATX heading in ``markdown``."""
+    """Return ``(level, text)`` for each ATX heading in ``markdown``.
+
+    Lines inside fenced code blocks (``` or ~~~) are ignored.
+    """
     headings = []
+    fence = None  # the opening fence string while inside a code block
     for line in markdown.splitlines():
+        fence_match = _FENCE.fullmatch(line)
+        if fence:
+            if (
+                fence_match
+                and fence_match.group(1)[0] == fence[0]
+                and len(fence_match.group(1)) >= len(fence)
+                and not fence_match.group(2).strip()
+            ):
+                fence = None
+            continue
+        if fence_match and not (
+            fence_match.group(1)[0] == "`" and "`" in fence_match.group(2)
+        ):
+            fence = fence_match.group(1)
+            continue
         match = _HEADING.fullmatch(line)
         if not match:
             continue
diff --git a/tests/test_headings.py b/tests/test_headings.py
index f3cefa8..74dd55e 100644
--- a/tests/test_headings.py
+++ b/tests/test_headings.py
@@ -8,3 +8,13 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+def test_headings_in_fenced_code_are_ignored():
+    doc = "# A\n```python\n# comment\n```\n## B\n~~~\n# x\n~~~~\n### C\n"
+    assert extract_headings(doc) == [(1, "A"), (2, "B"), (3, "C")]
+
+
+def test_longer_fence_needs_matching_close():
+    doc = "````\n```\n# inside\n```\n````\n# out\n"
+    assert extract_headings(doc) == [(1, "out")]
