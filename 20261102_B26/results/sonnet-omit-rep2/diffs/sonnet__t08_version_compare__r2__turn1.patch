+
+
+import pytest
+
+
+def test_numeric_not_lexical():
+    assert compare_versions("1.10", "1.9") == 1
+
+
+def test_prerelease():
+    assert compare_versions("2.0.0-rc1", "2.0.0") == -1
+    assert compare_versions("2.0.0", "2.0.0-rc1") == 1
+    assert compare_versions("1.0-alpha", "1.0-beta") == -1
+    assert compare_versions("1.0-rc1", "1.0-rc1") == 0
+    assert compare_versions("1.0-zzz", "1.1") == -1
+
+
+@pytest.mark.parametrize("bad", ["", "1..2", "1.", ".1", "a", "1.a", "1.0-", "-rc1", "1.-1", "1 .0", "1.0\n"])
+def test_invalid(bad):
+    with pytest.raises(ValueError):
+        compare_versions(bad, "1.0")
+    with pytest.raises(ValueError):
+        compare_versions("1.0", bad)
+    with pytest.raises(ValueError):
+        sort_versions([bad])
+
+
+def test_sort_prerelease_stable_and_new_list():
+    src = ["1.10", "1.0", "1.0-rc1", "1.0.0", "1.9"]
+    assert sort_versions(src) == ["1.0-rc1", "1.0", "1.0.0", "1.9", "1.10"]
+    assert src[0] == "1.10"
