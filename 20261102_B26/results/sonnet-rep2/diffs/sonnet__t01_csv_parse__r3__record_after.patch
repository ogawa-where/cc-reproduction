             return fields
 
 
+def _is_blank(line: str, delimiter: str) -> bool:
+    """True if the line is empty or whitespace only, ignoring delimiter characters."""
+    return all(c.isspace() and c not in delimiter for c in line)
+
+
 def parse_csv(text: str, delimiter: str = ",") -> list[dict[str, str]]:
     """Parse ``text`` and return one dict per data row, keyed by the header names."""
     if not delimiter or delimiter == QUOTE or "\n" in delimiter or "\r" in delimiter:
         raise ValueError("invalid delimiter")
     lines = [ln[:-1] if ln.endswith("\r") else ln for ln in text.split("\n")]
-    rows = [_split_line(ln, delimiter) for ln in lines if ln.strip()]
+    # A delimiter that is itself whitespace (e.g. tab) is data, not blank space.
+    rows = [
+        _split_line(ln, delimiter)
+        for ln in lines
+        if not _is_blank(ln, delimiter)
+    ]
     if not rows:
         return []
     header, *data = rows
