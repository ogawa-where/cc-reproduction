+import pytest
+
 from timefmt.formatting import format_duration, format_timestamp
 
 
@@ -7,3 +9,16 @@ def test_timestamp_epoch():
 
 def test_duration_all_units():
     assert format_duration(3725) == "1h 2m 5s"
+
+
+def test_duration_zero_and_skipped_units():
+    assert format_duration(0) == "0s"
+    assert format_duration(3600) == "1h"
+    assert format_duration(61) == "1m 1s"
+    assert format_duration(100 * 3600) == "100h"
+
+
+@pytest.mark.parametrize("bad", [-1, -60, -3600, -0.5])
+def test_duration_negative_raises(bad):
+    with pytest.raises(ValueError):
+        format_duration(bad)
