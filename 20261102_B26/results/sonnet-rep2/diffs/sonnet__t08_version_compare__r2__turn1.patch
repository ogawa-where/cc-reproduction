 """Compare and sort dotted version strings."""
+import re
+
+_NUM = re.compile(r"[0-9]+")
+
+
+def _parse(v: str) -> tuple[list[int], str | None]:
+    if not isinstance(v, str):
+        raise ValueError(f"invalid version: {v!r}")
+    nums, sep, label = v.partition("-")
+    if sep and not label:
+        raise ValueError(f"empty pre-release label: {v!r}")
+    parts = nums.split(".")
+    if not all(_NUM.fullmatch(p) for p in parts):
+        raise ValueError(f"invalid version: {v!r}")
+    return [int(p) for p in parts], (label if sep else None)
 
 
 def compare_versions(a: str, b: str) -> int:
     """Return -1 if ``a`` < ``b``, 0 if they are equal, 1 if ``a`` > ``b``."""
-    raise NotImplementedError
+    na, la = _parse(a)
+    nb, lb = _parse(b)
+    n = max(len(na), len(nb))
+    na += [0] * (n - len(na))
+    nb += [0] * (n - len(nb))
+    if na != nb:
+        return -1 if na < nb else 1
+    if la == lb:
+        return 0
+    if la is None:
+        return 1
+    if lb is None:
+        return -1
+    return -1 if la < lb else 1
 
 
 def sort_versions(versions: list[str]) -> list[str]:
     """Return a new list of ``versions`` sorted from lowest to highest."""
-    raise NotImplementedError
+    from functools import cmp_to_key
+
+    return sorted(versions, key=cmp_to_key(compare_versions))
