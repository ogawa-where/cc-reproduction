--- a/csvlite/parser.py
+++ b/csvlite/parser.py
@@ -1,6 +1,60 @@
 """Parse CSV text into a list of row dicts."""
 
+QUOTE = '"'
+
+
+def _split_line(line: str, delimiter: str) -> list[str]:
+    fields = []
+    i, n, dlen = 0, len(line), len(delimiter)
+    while True:
+        if line.startswith(QUOTE, i):
+            i += 1
+            buf = []
+            while True:
+                if i >= n:
+                    raise ValueError("unterminated quoted field")
+                ch = line[i]
+                if ch == QUOTE:
+                    if line.startswith(QUOTE, i + 1):
+                        buf.append(QUOTE)
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                buf.append(ch)
+                i += 1
+            if i < n and not line.startswith(delimiter, i):
+                raise ValueError("unexpected text after closing quote")
+            fields.append("".join(buf))
+        else:
+            j = line.find(delimiter, i)
+            if j == -1:
+                fields.append(line[i:])
+                return fields
+            fields.append(line[i:j])
+            i = j
+        if i >= n:
+            return fields
+        i += dlen  # skip delimiter; a trailing delimiter yields a final empty field
+        if i >= n:
+            fields.append("")
+            return fields
+
 
 def parse_csv(text: str, delimiter: str = ",") -> list[dict[str, str]]:
     """Parse ``text`` and return one dict per data row, keyed by the header names."""
-    raise NotImplementedError
+    if not delimiter or delimiter == QUOTE or "\n" in delimiter or "\r" in delimiter:
+        raise ValueError("invalid delimiter")
+    lines = [ln[:-1] if ln.endswith("\r") else ln for ln in text.split("\n")]
+    rows = [_split_line(ln, delimiter) for ln in lines if ln.strip()]
+    if not rows:
+        return []
+    header, *data = rows
+    result = []
+    for row in data:
+        if len(row) != len(header):
+            raise ValueError(
+                f"expected {len(header)} fields, got {len(row)}: {row!r}"
+            )
+        result.append(dict(zip(header, row)))
+    return result
