+import pytest
+
 from csvlite.parser import parse_csv
 
 
@@ -11,3 +13,26 @@ def test_basic_rows():
 
 def test_custom_delimiter():
     assert parse_csv("a;b\n1;2", delimiter=";") == [{"a": "1", "b": "2"}]
+
+
+def test_quotes_and_blank_lines():
+    text = '\n  \na,b\n\n"x,1","he said ""hi"""\n   \n,\n'
+    assert parse_csv(text) == [
+        {"a": "x,1", "b": 'he said "hi"'},
+        {"a": "", "b": ""},
+    ]
+
+
+def test_trailing_delimiter_and_crlf():
+    assert parse_csv("a,b\r\n1,\r\n") == [{"a": "1", "b": ""}]
+
+
+def test_field_count_mismatch():
+    with pytest.raises(ValueError):
+        parse_csv("a,b\n1\n")
+    with pytest.raises(ValueError):
+        parse_csv("a,b\n1,2,3\n")
+
+
+def test_empty():
+    assert parse_csv("") == []
