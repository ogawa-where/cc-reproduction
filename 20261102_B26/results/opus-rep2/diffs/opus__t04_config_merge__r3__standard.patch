 """Deep merge of configuration dictionaries."""
-import copy
+
+
+def _copy_containers(value):
+    """Copy dicts, lists and tuples recursively; return other values as-is.
+
+    Only containers need copying for the result to be independent of the
+    inputs. Leaf values are shared rather than deep-copied, so values that
+    cannot be copied (locks, file handles, clients, ...) are still accepted.
+    """
+    if isinstance(value, dict):
+        return {k: _copy_containers(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [_copy_containers(v) for v in value]
+    if isinstance(value, tuple):
+        return tuple(_copy_containers(v) for v in value)
+    return value
 
 
 def deep_merge(base: dict, override: dict) -> dict:
@@ -9,18 +24,22 @@ def deep_merge(base: dict, override: dict) -> dict:
