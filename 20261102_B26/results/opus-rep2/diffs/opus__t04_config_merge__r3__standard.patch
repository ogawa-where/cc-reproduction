diff --git a/tests/test_merge.py b/tests/test_merge.py
index 17c6cbc..8531e40 100644
--- a/tests/test_merge.py
+++ b/tests/test_merge.py
@@ -9,3 +9,39 @@ def test_nested_merge():
     base = {"db": {"host": "localhost", "port": 5432}}
     override = {"db": {"port": 6543}}
     assert deep_merge(base, override) == {"db": {"host": "localhost", "port": 6543}}
+
+
+import copy
+import threading
+
+
+def test_inputs_not_modified_and_result_independent():
+    base = {"a": {"x": [1, {"deep": 1}], "y": 1}, "l": [1, 2], "k": 1}
+    override = {"a": {"y": None, "z": {"q": None, "r": [2]}}, "k": None, "m": {"p": [{"s": 1}]}}
+    base_before, override_before = copy.deepcopy(base), copy.deepcopy(override)
+
+    result = deep_merge(base, override)
+    assert result == {"a": {"x": [1, {"deep": 1}], "z": {"r": [2]}}, "l": [1, 2], "m": {"p": [{"s": 1}]}}
+    assert base == base_before and override == override_before
+
+    result["a"]["x"].append(9)
+    result["a"]["x"][1]["deep"] = 2
+    result["a"]["z"]["r"].append(3)
+    result["l"].append(3)
+    result["m"]["p"][0]["s"] = 5
+    assert base == base_before and override == override_before
+
+
+def test_none_removes_keys_at_any_level():
+    assert deep_merge({"a": 1, "b": {"c": 1, "d": 2}}, {"a": None, "b": {"c": None}, "e": None}) == {"b": {"d": 2}}
+    assert deep_merge({"a": 1}, {"a": {"b": None, "c": 2}}) == {"a": {"c": 2}}
+
+
+def test_lists_replace():
+    assert deep_merge({"a": [1, 2]}, {"a": [3]}) == {"a": [3]}
+
+
+def test_uncopyable_leaf_values_accepted():
+    lock = threading.Lock()
+    assert deep_merge({"lock": lock}, {"a": 1})["lock"] is lock
+    assert deep_merge({}, {"h": {"lock": lock}})["h"]["lock"] is lock
