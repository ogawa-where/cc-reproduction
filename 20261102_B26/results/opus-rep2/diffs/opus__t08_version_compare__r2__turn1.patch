 """Compare and sort dotted version strings."""
 
+from functools import cmp_to_key
+
+_DIGITS = frozenset("0123456789")
+
+
+def _parse(version: str) -> tuple[tuple[int, ...], str | None]:
+    """Split ``version`` into its numeric components and optional pre-release label.
+
+    Trailing zero components are dropped so that "1.2" and "1.2.0" parse equal.
+    Raises ``ValueError`` for anything that is not a valid version.
+    """
+    if not isinstance(version, str):
+        raise ValueError(f"version must be a string, got {type(version).__name__}")
+
+    core, sep, label = version.partition("-")
+    if sep and not label:
+        raise ValueError(f"empty pre-release label in version {version!r}")
+
+    parts = core.split(".")
+    # Accept only plain ASCII digits: int() alone would also accept "+1", " 1",
+    # "1_0" and non-ASCII digits.
+    if any(not part or not set(part) <= _DIGITS for part in parts):
+        raise ValueError(f"invalid version {version!r}")
+
+    numbers = [int(part) for part in parts]
+    while len(numbers) > 1 and numbers[-1] == 0:
+        numbers.pop()
+    return tuple(numbers), (label if sep else None)
+
+
+def _compare_parsed(a: tuple[tuple[int, ...], str | None],
+                    b: tuple[tuple[int, ...], str | None]) -> int:
+    (a_nums, a_label), (b_nums, b_label) = a, b
+    length = max(len(a_nums), len(b_nums))
+    a_padded = a_nums + (0,) * (length - len(a_nums))
+    b_padded = b_nums + (0,) * (length - len(b_nums))
+    if a_padded != b_padded:
+        return -1 if a_padded < b_padded else 1
+
+    if a_label == b_label:
+        return 0
+    if a_label is None:  # release outranks pre-release
+        return 1
+    if b_label is None:
+        return -1
+    return -1 if a_label < b_label else 1
+
 
 def compare_versions(a: str, b: str) -> int:
     """Return -1 if ``a`` < ``b``, 0 if they are equal, 1 if ``a`` > ``b``."""
-    raise NotImplementedError
+    return _compare_parsed(_parse(a), _parse(b))
 
 
 def sort_versions(versions: list[str]) -> list[str]:
-    """Return a new list of ``versions`` sorted from lowest to highest."""
-    raise NotImplementedError
+    """Return a new list of ``versions`` sorted from lowest to highest.
+
+    The sort is stable: versions that compare equal keep their original order.
+    """
+    # Parse everything up front so invalid input is rejected even for lists
+    # too short for any comparison to happen.
+    parsed = [(_parse(v), v) for v in versions]
+    parsed.sort(key=cmp_to_key(lambda x, y: _compare_parsed(x[0], y[0])))
+    return [v for _, v in parsed]
