 """Compare and sort dotted version strings."""
 
+import re
+from functools import cmp_to_key
+
+_NUMBER = re.compile(r"[0-9]+")
+
+
+def _parse(version: str) -> tuple[list[int], str | None]:
+    """Split ``version`` into its numeric components and optional pre-release label."""
+    if not isinstance(version, str):
+        raise ValueError(f"version must be a string, got {type(version).__name__}")
+    core, sep, label = version.partition("-")
+    if sep and not label:
+        raise ValueError(f"empty pre-release label in version {version!r}")
+    parts = core.split(".")
+    for part in parts:
+        # fullmatch on an ASCII-only pattern rejects "", "+1", " 1", "1_0" and non-ASCII digits,
+        # all of which int() would otherwise accept or mis-handle.
+        if not _NUMBER.fullmatch(part):
+            raise ValueError(f"invalid version {version!r}")
+    return [int(p) for p in parts], (label if sep else None)
+
+
+def _cmp(x, y) -> int:
+    return (x > y) - (x < y)
+
+
+def _compare_parsed(a: tuple[list[int], str | None], b: tuple[list[int], str | None]) -> int:
+    nums_a, label_a = a
+    nums_b, label_b = b
+    width = max(len(nums_a), len(nums_b))
+    nums_a = nums_a + [0] * (width - len(nums_a))
+    nums_b = nums_b + [0] * (width - len(nums_b))
+    result = _cmp(nums_a, nums_b)
+    if result:
+        return result
+    if label_a is None and label_b is None:
+        return 0
+    if label_a is None:
+        return 1  # release is higher than its pre-release
+    if label_b is None:
+        return -1
+    return _cmp(label_a, label_b)
+
 
 def compare_versions(a: str, b: str) -> int:
     """Return -1 if ``a`` < ``b``, 0 if they are equal, 1 if ``a`` > ``b``."""
-    raise NotImplementedError
+    return _compare_parsed(_parse(a), _parse(b))
 
 
