 """Turn titles into URL slugs."""
+import re
+import unicodedata
+
+_SEPARATORS = re.compile(r"[^a-z0-9]+")
 
 
 def slugify(text: str, max_length: int | None = None) -> str:
-    """Return a URL slug for ``text``."""
-    raise NotImplementedError
+    """Return a URL slug for ``text``.
+
+    The slug is lowercase ASCII letters and digits joined by single hyphens.
+    Accented letters are transliterated via NFKD normalization with combining
+    marks dropped; any other character acts as a separator. If ``max_length``
+    is given, the slug is cut to at most that many characters (without a
+    trailing hyphen). Returns ``"n-a"`` if nothing is left.
+    """
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+    slug = _SEPARATORS.sub("-", stripped.lower()).strip("-")
+    if max_length is not None:
+        slug = slug[: max(max_length, 0)].rstrip("-")
+    return slug or "n-a"
