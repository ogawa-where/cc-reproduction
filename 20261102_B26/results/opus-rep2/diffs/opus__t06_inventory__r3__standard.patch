+import pytest
+
+from stock.inventory import InsufficientStock, Inventory
+
+
+@pytest.mark.parametrize(
+    "a, b",
+    [
+        (" ab-1 ", "AB-1"),
+        ("STRAẞE", "straße"),
+        ("K-1", "k-1"),  # Kelvin sign
+        ("Ω-2", "ω-2"),  # Ohm sign
+        ("ı", "I"),
+    ],
+)
+def test_sku_matching_is_case_insensitive_and_strips(a, b):
+    inv = Inventory()
+    inv.add(a, 2)
+    inv.add(b, 3)
+    assert inv.quantity(a) == inv.quantity(b) == 5
+    assert len(inv.report()) == 1
+
+
+def test_report_uppercase_sorted_and_positive_only():
+    inv = Inventory()
+    inv.add(" b ", 5)
+    inv.add("a", 5)
+    inv.add("c", 7)
+    inv.add("z", 1)
+    inv.remove("Z", 1)
+    assert inv.report() == [("C", 7), ("A", 5), ("B", 5)]
+
+
+def test_remove_too_many_raises_and_keeps_stock():
+    inv = Inventory()
+    inv.add("x", 2)
+    with pytest.raises(InsufficientStock):
+        inv.remove("X", 3)
+    assert inv.quantity("x") == 2
+    assert inv.quantity("never") == 0
 
 
