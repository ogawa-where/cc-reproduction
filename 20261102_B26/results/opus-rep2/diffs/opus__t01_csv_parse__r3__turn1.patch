 """Parse CSV text into a list of row dicts."""
 
+_QUOTE = '"'
+
+
+def _split_line(line: str, delimiter: str) -> list[str]:
+    """Split one line into fields, honouring double-quoted fields."""
+    fields: list[str] = []
+    i = 0
+    n = len(line)
+    while True:
+        if i < n and line[i] == _QUOTE:
+            # Quoted field: read until a lone closing quote; "" is a literal quote.
+            i += 1
+            buf: list[str] = []
+            while True:
+                if i >= n:
+                    raise ValueError(f"unterminated quoted field in line: {line!r}")
+                ch = line[i]
+                if ch == _QUOTE:
+                    if i + 1 < n and line[i + 1] == _QUOTE:
+                        buf.append(_QUOTE)
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                buf.append(ch)
+                i += 1
+            fields.append("".join(buf))
+            if i < n and line[i] != delimiter:
+                raise ValueError(
+                    f"unexpected character {line[i]!r} after closing quote in line: {line!r}"
+                )
+        else:
+            end = line.find(delimiter, i)
+            if end == -1:
+                end = n
+            fields.append(line[i:end])
+            i = end
+        if i >= n:
+            return fields
+        i += 1  # skip the delimiter; a trailing delimiter yields a final empty field
+
 
 def parse_csv(text: str, delimiter: str = ",") -> list[dict[str, str]]:
     """Parse ``text`` and return one dict per data row, keyed by the header names."""
