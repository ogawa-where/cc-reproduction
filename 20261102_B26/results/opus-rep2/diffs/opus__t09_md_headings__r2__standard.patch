 _HEADING_RE = re.compile(r"^(#{1,6}) +(.*)$")
 # Optional closing run of '#' preceded by a space.
 _CLOSING_RE = re.compile(r" +#+$")
+# Opening code fence: up to 3 spaces of indent, then 3+ backticks or tildes,
+# then an optional info string.
+_FENCE_OPEN_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
+
+
+def _opening_fence(line: str) -> str | None:
+    """Return the fence marker if ``line`` opens a fenced code block."""
+    match = _FENCE_OPEN_RE.match(line)
+    if not match:
+        return None
+    fence, info = match.groups()
+    # A backtick fence's info string may not contain backticks
+    # (otherwise the line is inline code, e.g. "```code```").
+    if fence[0] == "`" and "`" in info:
+        return None
+    return fence
+
+
+def _closes_fence(line: str, fence: str) -> bool:
+    """Return True if ``line`` closes the block opened by ``fence``.
+
+    The closing fence uses the same character, is at least as long as the
+    opening fence, and has nothing but whitespace after it.
+    """
+    stripped = line.strip()
+    if len(line) - len(line.lstrip(" ")) > 3:
+        return False
+    return (
+        len(stripped) >= len(fence)
+        and set(stripped) == {fence[0]}
+    )
 
 
