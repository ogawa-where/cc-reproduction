@@ -8,3 +8,38 @@ def test_two_levels():
 
 def test_no_headings():
     assert extract_headings("just a paragraph\nand another line\n") == []
+
+
+def test_heading_inside_fence_ignored():
+    doc = "# A\n```\n# not\n```\n# B\n"
+    assert extract_headings(doc) == [(1, "A"), (1, "B")]
+
+
+def test_info_string_line_does_not_close_fence():
+    doc = "```\n```python\n# not\n```\n# B\n"
+    assert extract_headings(doc) == [(1, "B")]
+
+
+def test_longer_fence_contains_shorter():
+    doc = "````\n```\n# not\n```\n````\n# B\n"
+    assert extract_headings(doc) == [(1, "B")]
+
+
+def test_tilde_fence():
+    doc = "~~~\n# not\n```\n# still not\n~~~\n# B\n"
+    assert extract_headings(doc) == [(1, "B")]
+
+
+def test_inline_code_line_is_not_fence():
+    doc = "```code```\n# A\n"
+    assert extract_headings(doc) == [(1, "A")]
+
+
+def test_indented_fence():
+    doc = "  ```\n# not\n  ```\n# B\n"
+    assert extract_headings(doc) == [(1, "B")]
+
+
+def test_closing_hashes_and_non_headings():
+    doc = "## Setup ##\n#hashtag\n####### seven\n# C#\n"
+    assert extract_headings(doc) == [(2, "Setup"), (1, "C#")]
